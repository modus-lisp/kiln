#!/usr/bin/env bash
# kiln — build and run the modus-lisp desktop image.
#
# Speaks to whichever container engine is present: Apple's `container` (the
# default on Apple silicon), docker, or podman.  Force one with KILN_ENGINE.
#
#   kiln build            build the image (first run: coffee)
#   kiln run              start the desktop, print the VNC address
#   kiln web              open the browser client (the default surface)
#   kiln config           ssh in with your own key and configure the box (menuconfig)
#   kiln desktop          the works, here: a window, a terminal, voice and ears
#   kiln local            run on THIS machine, no container (no isolation either)
#   kiln bundle [--zip]   pack the sources + a launcher into a movable folder
#   kiln view             a NATIVE window onto the desktop (glass-sdl)
#   kiln vnc              ALSO publish RFB and open a VNC client (off by default)
#   kiln stop             stop and remove the container
#   kiln status           engine, image, container, ports
#   kiln logs [-f]        container logs
#   kiln shell            a bash prompt inside the running desktop
#   kiln repl             an SBCL repl with the whole world already loaded
#   kiln eval '(form)'    evaluate a form in the RUNNING desktop, live
#   kiln modus            modus-lisp's OWN Lisp, hosted — a REPL or --script
#   kiln modus-rfb PORT   glass's RFB SERVER, on modus, on a port you name
#   kiln test             glass's RFB self-test, in a throwaway container
#   kiln profiles         saved flag sets: kiln local ... --save-profile=NAME
#   kiln models           voices and recognizers: what is here, and fetch more
#   kiln lock             refresh repos.lock from the org's live refs
#   kiln clean            remove the container and the image
#
# Env: KILN_ENGINE, KILN_IMAGE, KILN_NAME, KILN_DNS, KILN_HEAP,
#      GLASS_DISPLAY, GLASS_APPS, GLASS_VOICE, GLASS_EARS.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
IMAGE=${KILN_IMAGE:-modus-lisp/kiln}
# ...and so is the container's name, for the same reason: `kiln' on display 1, `kiln2'
# on display 2.  Otherwise a second `kiln run' finds the first already running and
# reports success about somebody else's desktop.
NAME=${KILN_NAME:-kiln$([[ ${GLASS_DISPLAY:-1} == 1 ]] || echo "${GLASS_DISPLAY:-1}")}
DISPLAY_N=${GLASS_DISPLAY:-1}

VNC_PORT=$((5900 + DISPLAY_N))
AUDIO_PORT=$((5910 + DISPLAY_N))
CTRL_PORT=$((4008 + DISPLAY_N))
# DERIVED FROM THE DISPLAY, like the three above, because a second desktop that
# collides on two of its five ports is not a second desktop.  The offsets are chosen
# so display 1 keeps the numbers it has always had: 8765 and 2222.
GW_PORT=${GW_PORT:-$((8764 + DISPLAY_N))}
# Two SBCLs share this container on the web path (desktop + gateway), and the
# engine's default is 1 GB.
KILN_MEM=${KILN_MEM:-4G}
# SBCL'S HEAP MUST BE SMALLER THAN THE CONTAINER, and it was exactly equal: -m 4G with
# --dynamic-space-size 4096.  The heap is not the process — the runtime, the mapped core,
# every thread's stack and the /tmp tmpfs (256M, and tmpfs pages count against the same
# limit) all sit on top of it.  Crossing the line does not signal anything in Lisp: the
# kernel kills the process, and the log simply stops mid-sentence.  Which is what it did.
#
# A gigabyte of headroom was the first answer and it was not enough: 3072 in a 4 GiB box
# still died, because gencgc does not hand freed pages back — RSS is the high-water mark of
# what was ever touched, not what is live.  A heap allowed to touch 3 GiB eventually does,
# and then the runtime and the tmpfs no longer fit beside it.  (Measured: killed at
# anon-rss 4077128 kB, status 137, with 131 MB actually live.)
#
# So the heap gets at most HALF the container.  Even fully touched it leaves as much again
# for the core, the stacks, the tmpfs and the encoders — the ceiling stops being reachable
# rather than being merely further away.  SBCL scales its GC thresholds off this number too
# (nursery = heap/12, per-generation = heap/100), so a smaller heap also collects more
# often and touches less in the first place.  KILN_HEAP still wins if somebody has a number
# in mind.
if [[ -z ${KILN_HEAP:-} ]]; then
  _mem_mb=${KILN_MEM%[gG]}
  if [[ $_mem_mb != "$KILN_MEM" ]]; then _mem_mb=$(( _mem_mb * 1024 ));
  else _mem_mb=${KILN_MEM%[mM]}; fi
  if [[ $_mem_mb =~ ^[0-9]+$ ]]; then
    if (( _mem_mb >= 512 )); then KILN_HEAP=$(( _mem_mb / 2 )); fi
    # Below 512M the default is left alone: that is not a small desktop, it is a
    # misconfiguration, and silently halving it would hide which one it is.
  fi
  unset _mem_mb
fi
SSH_PORT=${KILN_SSH_PORT:-$((2221 + DISPLAY_N))}
# Everything that must outlive an image rebuild: the box's SSH host key, the keys
# allowed to configure it, and the .config the TUI writes.
KILN_ETC=${KILN_ETC:-$HOME/.kiln}
# WHERE A PUBLISHED PORT LANDS ON THE HOST.  "-p 8765:8765" with no address is
# every interface, which is what the gateway and the ssh control plane were doing
# unconditionally — while the README said "only the screen is published", the
# screen being in fact the one that is conditional.  Loopback unless KILN_EXPOSE.
if [[ -n ${KILN_EXPOSE:-} ]]; then PUBLISH_ON=""; else PUBLISH_ON="127.0.0.1:"; fi
# Where the sibling checkouts live when running WITHOUT a container.  kiln sits
# among them, so its parent is the default.
KILN_ROOT=${KILN_ROOT:-$(cd -- "$ROOT/.." && pwd)}
# Where kiln keeps what it generates: the core, and the boot file per display.
KILN_STATE=${KILN_STATE:-$HOME/.kiln}

die() { printf 'kiln: %s\n' "$*" >&2; exit 1; }
note() { printf '\033[36mkiln:\033[0m %s\n' "$*" >&2; }

# ------------------------------------------------------------------- engine

detect_engine() {
  if [[ -n ${KILN_ENGINE:-} ]]; then echo "$KILN_ENGINE"; return; fi
  # Apple's container is preferred on macOS: it is the native VM story here.
  if [[ $(uname -s) == Darwin ]] && command -v container >/dev/null; then
    echo container; return
  fi
  for e in docker podman container; do
    command -v "$e" >/dev/null && { echo "$e"; return; }
  done
  die "no container engine found (install Apple container, docker, or podman)"
}

# LAZILY, and only for the commands that actually need a container.  This ran at
# top level, so `kiln local' and `kiln bundle' — the two commands whose entire
# purpose is not needing a container — died with "no container engine found" on
# any machine without docker or podman.  KILN_ENGINE=none did not help either:
# the PATH check below it rejected that too.  So the documented container-free
# path could not run on a container-free host, which is the only kind of host
# that needs it.
ENGINE=""
need_engine() {
  [[ -n $ENGINE ]] && return 0
  ENGINE=$(detect_engine) || exit 1
  command -v "$ENGINE" >/dev/null || die "engine '$ENGINE' is not on PATH"
}

# Apple's container needs its system service up, and says so rather than
# starting itself.  Starting it for the user is the whole point of a driver.
ensure_engine_up() {
  need_engine
  [[ $ENGINE == container ]] || return 0
  if ! container ls >/dev/null 2>&1; then
    note "starting the container system service"
    container system start >/dev/null 2>&1 \
      || die "could not start the container service — try: container system start"
  fi
}

# A fresh Apple container install has no guest kernel, and there is no way to
# ASK whether one is configured — `container system kernel` only has `set`.  So
# this is reactive: run the command, and if it failed for exactly that reason,
# install the kernel once and try again.  One download per machine, and the
# difference between `kiln build` working and `kiln build` sending you to a
# manual page.
with_kernel() {
  local log rc
  log=$(mktemp); rc=0
  "$@" 2>&1 | tee "$log" || rc=${PIPESTATUS[0]}
  if grep -q "kernel not configured" "$log"; then
    rm -f "$log"
    note "no guest kernel configured — installing the recommended one (one time)"
    container system kernel set --recommended \
      || die "could not install a kernel — try: container system kernel set --recommended"
    note "retrying"
    "$@"
    return
  fi
  rm -f "$log"
  return "$rc"
}

# THE FENCES.  Applied to every container this driver starts, which is the whole
# point: a hardening flag you have to remember is a hardening flag you do not
# have.  There was a `kiln agent' that turned these on for one subcommand; the
# desktop ran privileged the rest of the time, so the default was "no fence" and
# the default is what runs.
#
# What they are NOT is a network boundary.  A container here can reach the LAN --
# verified: an otherwise fenced container opened 445 on another host on this
# subnet.  For an image that carries an agent, the thing that matters is that
# everything it reads reaches the inference provider in the next request, and the
# LAN is full of readable things.  So this list fences the FILESYSTEM and the
# privileges, and the network is a separate problem that wants a separate answer
# (cl-transport can make egress Tor-only; that is not wired up here yet).
#
# Engines disagree about the spelling, and Apple's `container' has neither
# --security-opt nor --pids-limit.  Asking it costs one help invocation.
FENCE_ARGS=()
fences_computed=""
set_fence_args() {
  [[ -n $fences_computed ]] && return 0
  fences_computed=1
  local help; help=$("$ENGINE" run --help 2>&1)
  FENCE_ARGS=(--user 1000:1000)
  grep -q -- "--cap-drop"      <<<"$help" && FENCE_ARGS+=(--cap-drop ALL)
  grep -q -- "--security-opt"  <<<"$help" && FENCE_ARGS+=(--security-opt no-new-privileges)
  grep -q -- "--pids-limit"    <<<"$help" && FENCE_ARGS+=(--pids-limit 512)
  # A read-only rootfs needs somewhere to write, and the image sends fasls to
  # /tmp precisely so this is the only hole it needs.
  if [[ -z ${KILN_WRITABLE:-} ]] && grep -q -- "--read-only" <<<"$help"; then
    FENCE_ARGS+=(--read-only)
    # "path:options" is DOCKER's spelling.  Apple's container takes a bare PATH, and
    # given the docker form it does not complain -- it mounts a tmpfs at a directory
    # literally named "/tmp:rw,size=256m" and leaves the real /tmp on the read-only
    # rootfs.  Every fence flag still reads as applied, and the container still boots;
    # what breaks is the first process that tries to write a fasl, which is a long way
    # from the flag that caused it.
    if grep -q -- "--tmpfs" <<<"$help"; then
      if [[ $ENGINE == container ]]; then FENCE_ARGS+=(--tmpfs /tmp)
      else FENCE_ARGS+=(--tmpfs /tmp:rw,size=256m); fi
    fi
  fi
}

# Apple's guests are handed the vmnet gateway as their resolver, and on a good
# number of Macs it does not answer — apt, the seed fetch and Quicklisp all die
# with "Temporary failure resolving".  So pass an explicit one.
#
# The host's own resolver is used when a guest could actually reach it, which on
# macOS is often false: a Mac running mDNSResponder or a VPN client advertises a
# loopback address, and 127.x means something different inside the VM.  In that
# case fall back to a public resolver.  KILN_DNS overrides the lot.
DNS_ARGS=()
set_dns_args() {
  [[ $ENGINE == container ]] || return 0
  local ns=${KILN_DNS:-}
  if [[ -z $ns ]]; then
    ns=$(scutil --dns 2>/dev/null | awk '/nameserver\[0\]/ {print $3; exit}' || true)
    [[ -z $ns || $ns == 127.* ]] && ns=1.1.1.1
  fi
  DNS_ARGS=(--dns "$ns")
}

running() { ensure_engine_up; "$ENGINE" ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$NAME"; }
exists()  { ensure_engine_up; "$ENGINE" ls --all 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$NAME"; }

# ------------------------------------------------------------------ actions

cmd_build() {
  ensure_engine_up
  note "building $IMAGE with $ENGINE (this compiles McCLIM once; expect several minutes)"
  set_dns_args
  if [[ $ENGINE == container ]]; then
    with_kernel container build ${DNS_ARGS[@]+"${DNS_ARGS[@]}"} -t "$IMAGE" "$@" "$ROOT"
  else
    "$ENGINE" build -t "$IMAGE" "$@" "$ROOT"
  fi
  note "built $IMAGE"
}

# MODE is the entrypoint command.  "web" — the desktop plus the browser gateway —
# is the default, because the gateway is the surface that can actually be
# authenticated.  "desktop" is VNC only.
MODE=${MODE:-web}

cmd_run() {
  ensure_engine_up
  running && { note "already running"; cmd_address; return; }
  exists  && "$ENGINE" rm "$NAME" >/dev/null 2>&1 || true
  note "starting the desktop"
  set_dns_args
  set_fence_args
  "$ENGINE" run -d --name "$NAME" ${DNS_ARGS[@]+"${DNS_ARGS[@]}"} \
    "${FENCE_ARGS[@]}" \
    -e GLASS_DISPLAY="$DISPLAY_N" \
    ${KILN_HEAP:+-e KILN_HEAP="$KILN_HEAP"} \
    ${GLASS_APPS:+-e GLASS_APPS="$GLASS_APPS"} \
    ${GLASS_VOICE:+-e GLASS_VOICE="$GLASS_VOICE"} \
    ${GLASS_EARS:+-e GLASS_EARS="$GLASS_EARS"} \
    -m "$KILN_MEM" \
    -p "$PUBLISH_ON$GW_PORT:$GW_PORT" \
    -p "$PUBLISH_ON$SSH_PORT:$SSH_PORT" \
    -v "$KILN_ETC:/etc/kiln" \
    ${KILN_MOUNT_REPOS:+$(mount_repo_args)} \
    ${KILN_MOUNT_BOOT:+-v "$ROOT/boot:/kiln/boot"} \
    ${KILN_DEV_CACHE:+--tmpfs /home/kiln/.cache} \
    -e KILN_SSH_PORT="$SSH_PORT" \
    ${KILN_GC_SECONDS:+-e KILN_GC_SECONDS="$KILN_GC_SECONDS"} \
    ${KILN_VNC:+-p "$PUBLISH_ON$VNC_PORT:$VNC_PORT"} \
    ${KILN_VNC:+-e KILN_VNC="$KILN_VNC"} \
    ${KILN_VNC:+-e GLASS_BIND=0.0.0.0} \
    ${KILN_RESUME:+-e KILN_RESUME="$KILN_RESUME"} \
    ${KILN_NOSTR:+-e KILN_NOSTR="$KILN_NOSTR"} \
    "$@" "$IMAGE" "$MODE" >/dev/null
  # The desktop compiles nothing at startup, but the RFB listener still needs a
  # moment; polling beats a fixed sleep.
  for _ in $(seq 1 40); do
    host_reachable && break
    sleep 0.25
  done
  cmd_address
}

host_reachable() {
  # A VNC client connects to whatever the engine published; check that.
  #
  # NOT bash's /dev/tcp: macOS ships bash 3.2 built without net-redirections, so
  # there it fails on every port, open or not — a check that always says "no" is
  # worse than no check.  nc is present on macOS and on the distros this runs on.
  #
  # And not a bare connect test either: Apple's container publishes ports through
  # a host-side proxy that ACCEPTS before anything inside is listening, so `nc -z`
  # reports success against a dead port.  RFB servers announce themselves first
  # ("RFB 003.008\n"), so reading the banner is what actually proves a server.
  [[ $(nc -w 3 127.0.0.1 "$VNC_PORT" 2>/dev/null | head -c 3) == RFB ]]
}

cmd_address() {
  local ip=""
  if [[ $ENGINE == container ]]; then
    ip=$(container inspect "$NAME" 2>/dev/null \
         | grep -oE '"(address|ipv4)"[^,]*' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
  fi

  # Only the screen is published.  glass binds the session audio and the control
  # socket to loopback inside the container, so they are reached from in there —
  # `kiln eval` does exactly that.
  # WHICH SESSION.  The name is minted inside the image, so it is read back out of the
  # log rather than known here -- the same reason `kiln local --detach' waits for it.
  local sess
  sess=$("$ENGINE" logs "$NAME" 2>&1 | grep -m1 -E "^@@ session " | sed 's/^@@ session //' || true)
  [[ -n ${sess:-} ]] && note "session  $sess"
  note "browser  http://localhost:$GW_PORT/"
  if [[ -n ${KILN_VNC:-} ]]; then
    note "VNC      vnc://127.0.0.1:$VNC_PORT  (exposed by request)"
  else
    note "VNC      not published — container-local only (kiln vnc to expose)"
  fi
  note "config   kiln config    (ssh, your own key)"
  note "control  kiln eval '(glass:perf-report)'"
  note "audio    container-local on $AUDIO_PORT (glass binds it to loopback)"
}

# The browser path: noVNC over a WebRTC data channel, served from the container.
#
# No TLS, no certificate, no signalling relay and no TURN — because the port is
# published to the HOST'S LOOPBACK, and http://localhost is a secure context.
# Verified in Safari: isSecureContext, RTCPeerConnection, data channels and even
# getUserMedia all pass there.  The Nostr gateway beside this one solves a
# different problem — reaching a box that ISN'T the machine you are sitting at.
# ---- running on this machine, no container ---------------------------------
#
# The container buys isolation: the desktop's terminal is a root shell in a
# throwaway filesystem, and the ports it opens are the engine's to publish. None
# of that is true here -- `kiln local' is your user, your files, your ports. What
# it buys instead is that there is nothing to reason about: one SBCL process you
# can see in ps, reading the checkouts in place, so an edit is live on the next
# start with no image to rebuild.

host_prereqs() {
  command -v sbcl >/dev/null || die "no sbcl on PATH.
  kiln local runs on this machine's Lisp.  brew install sbcl, or use kiln run."
  [[ -f $HOME/quicklisp/setup.lisp ]] || die "no Quicklisp at ~/quicklisp.
  The desktop needs McCLIM, which comes from Quicklisp.  Install it from
  https://beta.quicklisp.org/quicklisp.lisp, or use kiln run."
  [[ -d $KILN_ROOT/glass ]] || die "no checkouts at $KILN_ROOT.
  kiln local reads the sibling repos in place; point KILN_ROOT at them, or
  unpack a bundle and run its own launcher."
}

# The core is what makes a start instant rather than a minute of McCLIM. Built
# once per machine, and only when missing -- editing a repo does NOT invalidate
# it, because ASDF still loads changed systems over the top on the next start.
# `kiln local --rebuild' is the button for when you want it re-dumped anyway.
ensure_local_core() {
  local core="$KILN_ETC/modus.core"
  if [[ -f $core && -z ${KILN_REBUILD:-} ]]; then LOCAL_CORE=$core; return; fi
  mkdir -p "$KILN_ETC"
  note "building a core for this machine (once; McCLIM takes a few minutes)"
  KILN_SOURCE_TREE="$KILN_ROOT" KILN_CORE="$core" \
    sbcl --dynamic-space-size 4096 --script "$ROOT/boot/build.lisp" || die "core build failed"
  LOCAL_CORE=$core
}

# ---- models -------------------------------------------------------------------------
# A voice and an ear are FILES, and both are big enough that nobody has them by accident:
# a Piper voice is ~60 MB, stave's encoder 262.  So the failure worth designing for is not
# a corrupt model, it is an absent one — and the way glass reported that was to come all
# the way up, draw the app, and put "No voice installed" in a status line you had to open
# a window to read.  The desktop was already running by the time it could tell you.
#
# These check before anything starts, and say the one command that fixes it.  Neither
# fetches on your behalf: 300 MB is not a thing to do as a side effect of --voice.

chord_voice_dir() { echo "${CHORD_VOICE_DIR:-$HOME/.chord/voices}"; }
stave_model_dir() { echo "${STAVE_MODEL_DIR:-$HOME/.stave/models}"; }

# A voice is a path, or a bare name resolved against chord's voice directory the same way
# CHORD:VOICE-PATH resolves it — .graph preferred, .onnx accepted, since either loads.
resolve_voice() {
  local v=$1 dir; dir=$(chord_voice_dir)
  case $v in
    */*|*.graph|*.onnx) [[ -f $v ]] && { echo "$v"; return 0; }; return 1 ;;
  esac
  [[ -f "$dir/$v.graph" ]] && { echo "$dir/$v.graph"; return 0; }
  [[ -f "$dir/$v.onnx"  ]] && { echo "$dir/$v.onnx";  return 0; }
  return 1
}

check_voice() {
  local v=$1 got
  if got=$(resolve_voice "$v"); then
    note "voice    $got"
    VOICE_RESOLVED=$got
    return 0
  fi
  cat >&2 <<EOF
kiln: --voice=$v — no such voice.

  Voices live in $(chord_voice_dir) and are named, not pathed:
  --voice=en_US-lessac-medium finds en_US-lessac-medium.graph there.
  A path with a / or a .graph/.onnx suffix is taken as given.

  Pull one:   kiln models fetch voice            (default: en_US-lessac-medium, ~63 MB)
              kiln models fetch voice=en_US-ljspeech-medium
  See what is here and what is offered:
              kiln models

EOF
  die "no voice at $v"
}

# An ear is a DIRECTORY of stave graphs -- encoder/decoder/joiner plus tokens.txt -- so an
# empty or half-fetched directory is the interesting failure, not a missing one.
check_ears() {
  local e=$1
  if [[ -d $e ]]; then
    local n; n=$(find "$e" -name '*.graph' 2>/dev/null | wc -l | tr -d ' ')
    if (( n >= 3 )) && [[ -f $e/tokens.txt ]]; then
      note "ears     $e ($n graphs)"
      return 0
    fi
    cat >&2 <<EOF
kiln: --ears=$e exists but is not a complete recognizer.

  Found $n .graph file(s)$([[ -f $e/tokens.txt ]] || echo " and no tokens.txt").  stave wants an
  encoder, a decoder and a joiner, plus tokens.txt.  An interrupted fetch looks
  exactly like this.

  Finish it:  kiln models fetch ears

EOF
    die "incomplete recognizer at $e"
  fi
  cat >&2 <<EOF
kiln: --ears=$e — no such directory.

  Recognizers live under $(stave_model_dir)/<model>/ and --ears takes that
  directory.  stave ships no weights: the encoder alone is 262 MB, past what
  GitHub accepts, and trained float32 does not compress.

  Pull one:   kiln models fetch ears            (zipformer-en-2023-06-26, ~300 MB, a few minutes)
  See what is here:
              kiln models

EOF
  die "no recognizer at $e"
}

# `kiln models' -- what is installed, what is on offer, and how to get it.  Both fetchers
# are Lisp (weft's TLS, mill's ONNX reader; no huggingface-cli, no Python), so this runs
# them from the core rather than reimplementing a download in bash.
cmd_models() {
  host_prereqs
  local sub=${1:-list} which="" name=""
  [[ $sub == fetch ]] && { which=${2:?usage: kiln models fetch voice|ears|all [=NAME]}; }
  case $which in *=*) name=${which#*=}; which=${which%%=*} ;; esac

  if [[ $sub == list ]]; then
    local vd sd; vd=$(chord_voice_dir); sd=$(stave_model_dir)
    printf '\n  voices   %s\n' "$vd"
    # NAMES, not files.  A voice on disk is four files (.graph, .bin, and two .json), and
    # listing them invites you to pass one to --voice, which wants the name.
    if compgen -G "$vd/*.graph" >/dev/null 2>&1 || compgen -G "$vd/*.onnx" >/dev/null 2>&1; then
      local f
      for f in "$vd"/*.graph "$vd"/*.onnx; do
        [[ -f $f ]] || continue
        printf '    %-34s %s\n' "$(basename "${f%.*}")" \
               "$(du -ch "${f%.*}".* 2>/dev/null | tail -1 | cut -f1)"
      done | sort -u
    else printf '    (none — kiln models fetch voice)\n'; fi
    printf '\n  ears     %s\n' "$sd"
    if [[ -d $sd ]] && [[ -n $(ls -A "$sd" 2>/dev/null) ]]; then
      local d
      for d in "$sd"/*/; do
        [[ -d $d ]] || continue
        printf '    %-34s %s graphs\n' "$(basename "$d")" \
               "$(find "$d" -name '*.graph' 2>/dev/null | wc -l | tr -d ' ')"
      done
    else printf '    (none — kiln models fetch ears)\n'; fi
    printf '\n  on offer (licence is the thing that decides what you may do with the result):\n'
    ensure_local_core
    # The catalogues live in chord/fetch and stave/fetch, which the core does not preload --
    # so they are loaded here.  NOT wrapped in ignore-errors: an empty "on offer" list that
    # means "the call failed" is indistinguishable from one that means "nothing is offered",
    # and this section exists precisely to tell you what you could have.
    sbcl --core "$LOCAL_CORE" --noinform --disable-debugger --eval '
      (handler-bind ((warning (function muffle-warning)))
        (flet ((catalogue (system fn)
                 (handler-case
                     (progn (let ((*standard-output* (make-broadcast-stream)))
                              (asdf:load-system system))
                            (funcall (read-from-string fn)))
                   (error (e) (format t "~&  ~a: unavailable — ~a~%" system e)))))
          (format t "~&  voices (chord):~%")   (catalogue :chord/fetch "chord:available-voices")
          (format t "~&  recognizers (stave):~%") (catalogue :stave/fetch "stave:available-models"))
        (sb-ext:quit))' 2>&1 | grep -v "^;" | sed 's/^/  /'
    printf '\n  kiln models fetch voice[=NAME] | ears | all\n\n'
    return 0
  fi

  [[ $sub == fetch ]] || die "models: unknown subcommand $sub (list, fetch)"
  ensure_local_core

  # A fetch is minutes and hundreds of megabytes, so it says what it is about to do first
  # and the size is named rather than discovered halfway through.
  case $which in
    voice|ears|all) ;;
    *) die "models fetch: want voice, ears or all (got $which)" ;;
  esac

  if [[ $which == voice || $which == all ]]; then
    note "fetching voice ${name:-(chord default)} -> $(chord_voice_dir)  (~63 MB)"
    sbcl --core "$LOCAL_CORE" --dynamic-space-size "${KILN_FETCH_HEAP:-8192}" \
         --noinform --disable-debugger --eval "
      (progn (asdf:load-system :chord/fetch)
             (let ((p (funcall (read-from-string \"chord:fetch-voice\")
                               ${name:+\"$name\"}${name:-(symbol-value (read-from-string \"chord::*default-voice*\"))})))
               (format t \"~&kiln/models: voice at ~a~%\" p))
             (sb-ext:quit))" || die "voice fetch failed"
  fi

  if [[ $which == ears || $which == all ]]; then
    note "fetching recognizer -> $(stave_model_dir)  (~300 MB, a few minutes; 262 MB of it is the encoder)"
    # A BIGGER HEAP THAN THE DESKTOP RUNS IN, on purpose.  The download is streamed but the
    # ONNX -> .graph conversion is not: %EMIT-TENSOR grows one adjustable vector, and
    # VECTOR-PUSH-EXTEND doubles, so a 262 MB encoder asks for a 256 MB contiguous block
    # while already holding the old one.  With the default heap that fails at exactly the
    # last step -- after the whole 262 MB has been fetched, which is the most annoying
    # possible moment.  This is a one-shot conversion, not a running desktop, so it can
    # have the room.
    sbcl --core "$LOCAL_CORE" --dynamic-space-size "${KILN_FETCH_HEAP:-8192}" \
         --noinform --disable-debugger --eval '
      (progn (asdf:load-system :stave/fetch)
             (let ((d (funcall (read-from-string "stave:fetch-model"))))
               (format t "~&kiln/models: recognizer at ~a~%" d))
             (sb-ext:quit))' || die "recognizer fetch failed"
  fi
  note "done — kiln models"
}

# ---- flags, in a file ---------------------------------------------------------------
#
# The command lines here got long, and a long command line lives in shell history rather
# than in a file: it stops being read, stops being edited, and starts being pasted.  That is
# how a flag nobody understands survives for months.
#
# A profile is LITERALLY THE FLAGS, one per line, with comments.  Not a new configuration
# language with its own mapping onto the flags -- that mapping is the part that rots, and
# the part that makes you check the source to find out what a setting does.  If you can type
# it you can save it, and what you read in the file is what you would have typed.
#
# It EXPANDS IN PLACE, so ordering keeps working the way ordering already works: flags after
# --profile override what it contained, and a second --profile inside a profile composes.
# The existing ~/.kiln/config is untouched and still does its own job -- that file carries
# ENVIRONMENT (GLASS_VOICE and friends, read by the image), this one carries ARGUMENTS (read
# by kiln).  Two things, deliberately not merged: one is a standing preference for any
# session, the other is one way of starting one.

profile_path() {
  # A path if it looks like one, otherwise a name under the profile directory.
  case $1 in
    */*|*.flags) echo "$1" ;;
    *) echo "$KILN_STATE/profiles/$1.flags" ;;
  esac
}

expand_profiles() {
  # Echoes the argument list with every --profile=X replaced by that file's flags.
  local -a out=()
  local a f line
  for a in "$@"; do
    case $a in
      --profile=*)
        f=$(profile_path "${a#*=}")
        [[ -f $f ]] || die "no such profile: ${a#*=} (looked in $f)"
        while IFS= read -r line || [[ -n $line ]]; do
          line=${line%%#*}                                   # trailing comments
          line=${line#"${line%%[![:space:]]*}"}              # trim both ends
          line=${line%"${line##*[![:space:]]}"}
          [[ -z $line ]] && continue
          out+=("$line")
        done < "$f"
        ;;
      *) out+=("$a") ;;
    esac
  done
  printf '%s\n' ${out[@]+"${out[@]}"}
}

cmd_profiles() {
  local dir="$KILN_STATE/profiles"
  printf '\n  profiles  %s\n' "$dir"
  if [[ -d $dir ]] && compgen -G "$dir/*.flags" >/dev/null 2>&1; then
    local f
    for f in "$dir"/*.flags; do
      printf '    %-20s %s\n' "$(basename "${f%.flags}")" \
             "$(grep -v '^[[:space:]]*#' "$f" | grep -v '^[[:space:]]*$' | tr '\n' ' ' | cut -c1-70)"
    done
  else
    printf '    (none — kiln local ... --save-profile=NAME)\n'
  fi
  printf '\n  kiln local --profile=NAME   |   kiln desktop --profile=NAME\n\n'
}

# ---- the whole desktop, in one word ------------------------------------------------
#
# `kiln local' is deliberately a kit: nothing is enabled unless you name it, because a
# capability that arrives because a file happened to be on the disk is a capability nobody
# chose.  That is right, and it is also why starting the desktop I actually want had grown
# into a line with six flags in it -- long enough to keep in shell history rather than type,
# which means it stops being edited and starts being cargo.
#
# So: one word that means "the works, here".  The opt-in has not gone anywhere -- it has
# moved from six flags to the name of the command, which is a thing you can still choose not
# to type.  What it turns on it SAYS, every time, because a desktop that quietly acquired an
# ear is exactly what --voice and --ears were kept explicit to avoid.
#
# Everything after `kiln desktop' is passed through to `kiln local', so --resume, --size and
# the rest still work and still win: this composes with the kit rather than replacing it.
cmd_desktop() {
  host_prereqs
  [[ -f $ROOT/boot/config.sh ]] && { KILN_ETC="$KILN_ETC" . "$ROOT/boot/config.sh"; load_config; }

  # A LIVE LINK, always.  Not a debugging extra: a desktop you can only observe by screenshot
  # is one where every question about its state has to be answered by rebuilding the situation
  # somewhere else and hoping it is the same situation.  That is slow and it is unreliable —
  # a reconstruction that behaves differently from the real thing looks exactly like a
  # reconstruction that behaves the same.
  #
  # A 0600 socket file in the runtime directory, which is the same posture `kiln local
  # --control' has always had; the difference is that the command whose point is "the works"
  # now includes it, rather than leaving it to be remembered.
  local -a args=(--view --apps=terminal --control)
  local voice="" ears="" vd sd
  vd=$(chord_voice_dir); sd=$(stave_model_dir)

  # A voice, if one is installed.  The chord default first, then whatever else is there --
  # a single installed voice is not ambiguous and asking which would be pedantic.
  if [[ -n ${GLASS_VOICE:-} ]]; then
    voice=$GLASS_VOICE
  elif [[ -f "$vd/en_US-lessac-medium.graph" ]]; then
    voice=en_US-lessac-medium
  else
    local f
    for f in "$vd"/*.graph "$vd"/*.onnx; do
      [[ -f $f ]] || continue
      voice=$(basename "${f%.*}"); break
    done
  fi

  # An ear, likewise: the first complete recognizer under stave's model directory.
  if [[ -n ${GLASS_EARS:-} ]]; then
    ears=$GLASS_EARS
  elif [[ -d $sd ]]; then
    local d
    for d in "$sd"/*/; do
      [[ -d $d ]] || continue
      if (( $(find "$d" -name '*.graph' 2>/dev/null | wc -l) >= 3 )) && [[ -f $d/tokens.txt ]]; then
        ears=${d%/}; break
      fi
    done
  fi

  [[ -n $voice ]] && args+=("--voice=$voice")
  [[ -n $ears  ]] && args+=("--ears=$ears")

  # SAID OUT LOUD, both halves.  What is on, and what is off together with the one command
  # that would turn it on -- an absent capability should never be a mystery you go looking
  # for, which is the whole reason `kiln models' prints what it prints.
  note "desktop  a window here, a terminal in it"
  if [[ -n $voice ]]; then note "voice    $voice"
  else note "voice    none installed — kiln models fetch voice"; fi
  if [[ -n $ears ]]; then note "ears     $(basename "$ears")"
  else note "ears     none installed — kiln models fetch ears"; fi

  # Detached, because a desktop is not a command you are waiting on -- the same reasoning
  # `kiln local' already applies, made the default for the command whose whole point is that
  # you asked for a desktop and not for a REPL.  --no-detach if you want the REPL too.
  local detach=1 a
  for a in "$@"; do [[ $a == --no-detach ]] && detach=""; done
  [[ -n $detach ]] && args+=(--detach)

  # ${arr[@]+...} because `set -u' treats an empty array's expansion as unbound on the bash
  # that ships with macOS -- so the no-extra-flags case, which is the whole point of this
  # command, was the one that failed.
  local -a passthru=()
  for a in "$@"; do [[ $a == --no-detach ]] || passthru+=("$a"); done

  cmd_local "${args[@]}" ${passthru[@]+"${passthru[@]}"}
}

cmd_local() {
  # THE SAME .config THE CONTAINER READS, through the same reader (boot/config.sh).
  # ~/.kiln is the box's state, not a session's, so a setting recorded there means the
  # same thing whether the desktop runs in a container or on this machine.  The
  # environment still wins, so a flag typed now is never overridden by a file written
  # weeks ago.
  # shellcheck source=boot/config.sh
  [[ -f $ROOT/boot/config.sh ]] && { KILN_ETC="$KILN_ETC" . "$ROOT/boot/config.sh"; load_config; }

  # Every capability is OFF.  A bare `kiln local' is the core and nothing else:
  # SBCL's REPL on stdin and stdout, the whole workspace loaded, not a byte
  # leaving the process.  That is the useful shape of useless — you can reach
  # anything from a REPL, and nothing reaches you.
  local vnc="" vnc_sock="" view="" control="" audio="" apps="" gateway="" gateway_id="" nostr=""
  local size="" wallpaper="" voice="" ears="" config="" expose="" sshd=""
  local display=${GLASS_DISPLAY:-1}
  # Kept before the parse loop eats them: the header records the command that
  # produced the file, which is the only reason a generated file is readable.
  local invocation="kiln local${*:+ $*}"

  # PROFILES FIRST, so everything below — including --help and the die-on-unknown-option —
  # sees the flags a profile contained exactly as if they had been typed.
  local -a expanded=()
  if [[ "$*" == *--profile=* ]]; then
    while IFS= read -r line; do expanded+=("$line"); done < <(expand_profiles "$@")
    set -- ${expanded[@]+"${expanded[@]}"}
  fi

  # ...and --save-profile writes down what this invocation was, minus itself, so the epic
  # command line you just got right becomes the short one you type next time.  Recorded
  # AFTER expansion, so saving a run that used a profile saves the flags rather than a
  # reference to a file that may change under it.
  local save="" keep=() a
  for a in "$@"; do
    case $a in
      --save-profile=*) save=${a#*=} ;;
      *) keep+=("$a") ;;
    esac
  done
  if [[ -n $save ]]; then
    set -- ${keep[@]+"${keep[@]}"}
    local pf; pf=$(profile_path "$save")
    mkdir -p "$(dirname "$pf")"
    {
      printf '# %s — written by kiln local --save-profile\n' "$(basename "${pf%.flags}")"
      printf '# These are flags, one per line: what you would have typed.\n#\n'
      printf '#   kiln local --profile=%s\n\n' "$(basename "${pf%.flags}")"
      printf '%s\n' ${keep[@]+"${keep[@]}"}
    } > "$pf"
    note "profile  saved $pf"
  fi

  while [[ $# -gt 0 ]]; do
    local arg=$1 val=""
    [[ $arg == *=* ]] && { val=${arg#*=}; arg=${arg%%=*}; }
    case $arg in
      --rebuild)    KILN_REBUILD=1 ;;
      --ssh)        sshd=1 ;;
      --display)    display=${val:?--display=N} ;;
      # the screen: a socket file where a viewer is local, a port where it is not
      --vnc)        vnc=${val:-auto} ;;
      --vnc-socket) vnc_sock=${val:-auto} ;;
      --view)       view=1 ;;
      --detach|-d)  DETACH=1 ;;
      --resume)     KILN_RESUME=${val:-1} ;;
      --control)    control=${val:-auto} ;;
      --audio)      audio=${val:-auto} ;;
      --apps)       apps=${val:?--apps=terminal,...} ;;
      --size)       size=${val:?--size=WxH} ;;
      --wallpaper)  wallpaper=${val:?--wallpaper=PATH} ;;
      --voice)      voice=${val:?--voice=PATH-to-graph} ;;
      --ears)       ears=${val:?--ears=PATH} ;;
      --gateway)    gateway=${val:-auto} ;;
      --nostr)      nostr=${val:-1} ;;
      --gateway-id) gateway_id=${val:?--gateway-id=ID} ;;
      --config)     config=${val:?--config=FILE} ;;
      --expose)     expose=1 ;;
      --profile)    : ;;                       # already expanded above
      --save-profile) : ;;                     # already handled above
      -h|--help)    local_usage; return 0 ;;
      *) die "local: unknown option $arg (try: kiln local --help)" ;;
    esac
    shift
  done

  host_prereqs
  ensure_local_core

  # BEFORE the boot file is written and the image starts: a missing model is a typo or an
  # un-run fetch, and both are cheaper to hear about now than from a status line inside a
  # desktop that already came up.  CHECK-VOICE resolves a bare name to the file it found.
  [[ -n $voice ]] && { check_voice "$voice"; voice=$VOICE_RESOLVED; }
  [[ -n $ears  ]] && check_ears "$ears"

  local addr=127.0.0.1; [[ -n $expose ]] && addr=0.0.0.0
  local boot="$KILN_STATE/boot-$display.lisp"
  mkdir -p "$KILN_STATE"

  # A config file is the OTHER way in: the demo desktops are ordinary Lisp files
  # and stay that way.  Naming one bypasses generation entirely.
  if [[ -n $config ]]; then
    [[ -f $config ]] || die "no such config: $config"
    note "config   $config (generation skipped)"
    exec_local "$config" "$display" "$addr" "$gateway" "$gateway_id"
  fi

  {
    printf ';;;; GENERATED BY KILN — edits here are overwritten on the next run.\n'
    printf ';;;; %s\n' "$invocation"
    printf ';;;;\n;;;; Only what was asked for is in this file.  A capability that is not\n'
    printf ';;;; named on the command line does not appear, so what the image does is\n'
    printf ';;;; the list of things somebody typed.\n\n'
    printf '(in-package :cl-user)\n\n'

    [[ -n $size || -n $wallpaper || -n $vnc || -n $vnc_sock || -n $view ]] &&
      printf '(setf glass:*desktop-name* "modus-lisp :: glass desktop :%s")\n\n' "$display"

    # EVERY SESSION HAS AN IDENTITY, whether or not anything is listening on it.  That is
    # what the desktop wears in its corner and what an RFB client shows in its title bar,
    # so a screen says which session it is without being asked -- and if nostr is turned
    # on later, the key it signs with is the one this session already had.
    printf '(load "%s/boot/session.lisp")\n' "$ROOT"
    printf '(defvar *kiln-session-name* nil)\n'
    printf '(defvar *kiln-session-sec* nil)\n'
    printf '(multiple-value-bind (name sec npub fresh) (kiln-session)\n'
    printf '  (setf *kiln-session-name* name *kiln-session-sec* sec)\n'
    printf '  (setf glass:*desktop-name* name)\n'
    printf '  (format t "~&kiln: session  ~a (~:[resumed~;new~])~%%" name fresh)\n'
    printf '  (when npub (format t "kiln:          ~a~%%" npub)))\n\n'

    if [[ -n $control ]]; then
      if [[ $control == auto ]]; then
        # A SOCKET FILE, not a port.  This is an unauthenticated EVAL: whoever
        # reaches it runs Lisp in this image.  0600 and SO_PEERCRED beat loopback.
        printf '(clim-glass:start-control-socket :path (glass:socket-path "kiln-%s.control"))\n' "$display"
        printf '(format t "~&kiln: control  ~a~%%" (glass:socket-path "kiln-%s.control"))\n\n' "$display"
      elif [[ $control == /* ]]; then
        printf '(clim-glass:start-control-socket :path "%s")\n' "$control"
        printf '(format t "~&kiln: control  %s~%%")\n\n' "$control"
      else
        printf '(clim-glass:start-control-socket :port %s)\n' "$control"
        printf '(format t "~&kiln: control  127.0.0.1:%s (unauthenticated eval)~%%")\n\n' "$control"
      fi
    fi

    if [[ -n $audio ]]; then
      local ap=${audio}; [[ $ap == auto ]] && ap=$((5910 + display))
      printf '(let ((start (find-symbol "START-SESSION-AUDIO" :glass)))\n'
      printf '  (if (and start (fboundp start))\n'
      printf '      (progn (funcall start :port %s :address "%s")\n' "$ap" "$addr"
      printf '             (format t "~&kiln: audio    %s:%s~%%"))\n' "$addr" "$ap"
      printf '      (format t "~&kiln: audio    unavailable (:glass/audio-stream not loaded)~%%")))\n\n'
    fi

    # THE VOICE IS OPT-IN TOO.  glass used to switch it on merely because a model
    # file happened to be on the disk, which is a capability arriving by accident.
    [[ -n $voice ]] && {
      printf '(let ((var (find-symbol "*SPEECH-VOICE*" :glass)))\n'
      printf '  (when (and var (boundp var))\n'
      printf '    (setf (symbol-value var) "%s")\n' "$voice"
      printf '    (format t "~&kiln: voice    %s~%%")))\n\n' "$voice"
    }
    [[ -n $ears ]] && {
      printf '(sb-posix:setenv "GLASS_EARS" "%s" 1)\n' "$ears"
      printf '(format t "~&kiln: ears     %s~%%")\n\n' "$ears"
    }

    if [[ -n $gateway ]]; then
      local gp=${gateway}; [[ $gp == auto ]] && gp=${GW_PORT:-8765}
      printf '(sb-posix:setenv "GLASS_HOST" "127.0.0.1" 1)\n'
      printf '(sb-posix:setenv "GLASS_PORT" "%s" 1)\n' "$((5900 + display))"
      printf '(sb-posix:setenv "GW_PORT" "%s" 1)\n' "$gp"
      [[ -n $gateway_id ]] && printf '(sb-posix:setenv "GW_ID" "%s" 1)\n' "$gateway_id"
      printf '(sb-thread:make-thread\n'
      printf '  (lambda ()\n'
      printf '    (handler-case (load "%s/webrtc-data/demo/glass-webrtc/gateway.lisp")\n' "$KILN_ROOT"
      printf '      (error (e) (format *error-output* "~&kiln: gateway failed: ~a~%%" e))))\n'
      printf '  :name "kiln-gateway")\n'
      printf '(format t "~&kiln: gateway  http://127.0.0.1:%s/~%%")\n\n' "$gp"
    fi

    # NOSTR SIGNALLING, exactly the shape of --gateway above: an environment, a thread,
    # and a line saying what happened.  The differences are what this gateway needs that
    # the browser one does not -- an identity, and a client to serve.
    #
    # It is an RFB CLIENT of this desktop, so it needs a wire to reach it: --vnc or
    # --vnc-socket.  --view alone is a desktop with no wire at all, which is the whole
    # point of --view and exactly why nostr cannot ride on it.
    if [[ -n $nostr ]]; then
      # The admission endpoint FOLLOWS THE SCREEN, the same rule the gateway uses to find
      # it: a socket screen means the .admit socket beside it, a port means the default
      # port.  Derived once here so the two ends cannot drift.
      local admit_path='nil'
      if [[ -n $vnc_sock ]]; then
        if [[ $vnc_sock == auto ]]; then
          admit_path="(glass:socket-sibling (glass:socket-path \"kiln-$display.rfb\") \"admit\")"
        else
          admit_path="(glass:socket-sibling \"$vnc_sock\" \"admit\")"
        fi
      fi
      # WHO IT IS FOR.  --nostr=<npub|hex|name@domain> names one identity, and it answers
      # two questions that happen to have the same answer: who may connect, and who gets
      # told the desktop is up.  Bare --nostr leaves the allowlist to the .config and
      # sends nobody anything.
      if [[ $nostr != 1 ]]; then
        printf '(progn (sb-posix:setenv "GLASS_NOSTR_ALLOW" "%s" 1)\n' "$nostr"
        printf '       (sb-posix:setenv "GLASS_LINK_TO" "%s" 1)\n' "$nostr"
        # ...and where the link points.  GLASS:*LOGIN-URL-BASE* is read from the
        # environment when :glass/nostr LOADS, which for a saved core was build time --
        # so the variable is set directly, not just the variable's source.
        printf '       (unless glass:*login-url-base*\n'
        printf '         (setf glass:*login-url-base*\n'
        printf '               (or (sb-ext:posix-getenv "GLASS_LOGIN_URL_BASE")\n'
        printf '                   (format nil "https://~a.nsite.lol/"\n'
        printf '                           (or (sb-ext:posix-getenv "NSITE_NPUB")\n'
        printf '                               "%s")))))\n' "npub1ajvjnhgcmdxkng22lzsh22qvl63es78gk6p9mwksepju974teguq4l4evc"
        printf ')\n'
      fi
      # The identity is the SESSION's, minted above.  There is no host key to fall back
      # to and that is deliberate: a fallback is how one key ends up signing for four
      # desktops again on the machine nobody re-read the configuration on.
      printf '(cond\n'
      printf '  ((not (and *kiln-session-sec* (= (length *kiln-session-sec*) 64)))\n'
      printf '   (format t "~&kiln: nostr    this session has no identity — not starting~%%"))\n'
      printf '  (t\n'
      printf '   (sb-posix:setenv "NOSTR_SEC" *kiln-session-sec* 1)\n'
      printf '   (sb-posix:setenv "GLASS_NOSTR_SEC" *kiln-session-sec* 1)\n'
      if [[ -n $vnc_sock ]]; then
        local sp=$vnc_sock
        [[ $sp == auto ]] \
          && printf '   (sb-posix:setenv "GLASS_HOST" (format nil "unix:~a" (glass:socket-path "kiln-%s.rfb")) 1)\n' "$display" \
          || printf '   (sb-posix:setenv "GLASS_HOST" "unix:%s" 1)\n' "$sp"
      else
        local vp=$vnc; [[ $vp == auto ]] && vp=$((5900 + display))
        printf '   (sb-posix:setenv "GLASS_HOST" "127.0.0.1" 1)\n'
        printf '   (sb-posix:setenv "GLASS_PORT" "%s" 1)\n' "$vp"
      fi
      printf '   (let ((p (find-if (function probe-file)\n'
      printf '                     (list "%s/payload.js"\n' "$KILN_ETC"
      printf '                           "%s/webrtc-data/demo/glass-webrtc/payload.js"))))\n' "$KILN_ROOT"
      printf '     (when p (sb-posix:setenv "PAYLOAD_CHANNEL" "1" 1)\n'
      printf '             (sb-posix:setenv "PAYLOAD_FILE" (namestring p) 1)))\n'
      printf '   (unless (sb-ext:posix-getenv "VIDEO_PRIMARY")\n'
      printf '     (sb-posix:setenv "VIDEO_PRIMARY" "1" 1))\n'
      # ADMISSION: the desktop answers it, the gateway only asks.  serve-desktop.lisp does
      # this in the container; here the boot file calls RUN-WM directly, so without it the
      # gateway starts perfectly and refuses every offer.
      printf '   (let ((mk (find-symbol "START-SESSION-NOSTR" :glass))\n'
      printf '         (sv (find-symbol "*BOX-SECRET*" :glass)))\n'
      printf '     (when sv (setf (symbol-value sv) *kiln-session-sec*))\n'
      printf '     (when (and mk (fboundp mk))\n'
      printf '       (handler-case (funcall mk :path %s)\n' "$admit_path"
      printf '         (error (e) (format t "~&kiln: nostr    admission failed: ~a~%%" e)))))\n'
      printf '   (sb-thread:make-thread\n'
      printf '     (lambda ()\n'
      printf '       (handler-case (load "%s/webrtc-data/demo/glass-webrtc/gateway-nostr.lisp")\n' "$KILN_ROOT"
      printf '         (error (e) (format *error-output* "~&kiln: nostr failed: ~a~%%" e))))\n'
      printf '     :name "kiln-nostr")\n'
      printf '   (format t "~&kiln: nostr    signalling on — reaching this session from away~%%")))\n\n'
    fi

    # SSH IS A SERVER, and starting one should never be a side effect of starting a
    # desktop — one.lisp said exactly that and this carries it.  KILN_SSHD_EMBEDDED
    # stops sshd.lisp self-starting, and more to the point stops its "refusing to
    # start" path calling QUIT on the whole image over a missing key file.
    [[ -n $sshd ]] && {
      printf '(let ((f "%s/boot/sshd.lisp")\n' "$ROOT"
      printf '      (key "%s/host_ed25519"))\n' "$KILN_ETC"
      printf '  (cond ((not (probe-file f)) (format t "~&kiln: ssh      no sshd.lisp~%%"))\n'
      printf '        ((not (probe-file key)) (format t "~&kiln: ssh      no host key at ~a~%%" key))\n'
      printf '        (t (sb-posix:setenv "KILN_SSHD_EMBEDDED" "1" 1)\n'
      printf '           (handler-case\n'
      printf '               (progn (load f)\n'
      printf '                      (sb-thread:make-thread\n'
      printf '                        (lambda () (handler-case (funcall (read-from-string "start"))\n'
      printf '                                     (error (e) (format *error-output* "~&kiln: ssh stopped: ~a~%%" e))))\n'
      printf '                        :name "kiln-sshd")\n'
      printf '                      (format t "~&kiln: ssh      control plane up~%%"))\n'
      printf '             (error (e) (format *error-output* "~&kiln: ssh failed: ~a~%%" e))))))\n\n'
    }

    # ---- the screen, LAST, because whatever draws it keeps the main thread ----
    #
    # --view is the one-image shape: the desktop composites into a framebuffer and SDL
    # puts that framebuffer on your screen, in this process, with NO WIRE AT ALL.  No
    # port, no socket file, no RFB handshake, no encode/decode -- the viewer reads the
    # pixels where they already are.  RUN-WM is the same thing with a listener bolted
    # into the middle of it, which is worth having when the viewer is elsewhere and is
    # pure ceremony when it is not.
    #
    # Two threads and not two processes: SDL owns the main thread because Cocoa insists
    # on it, so the compositor gets the background one.
    if [[ -n $view ]]; then
      [[ -d $KILN_ROOT/glass-sdl ]] || die "--view needs glass-sdl at $KILN_ROOT/glass-sdl"
      local w=1280 h=800
      [[ -n $size ]] && { w=${size%%x*}; h=${size##*x}; }
      printf '(handler-bind ((warning (function muffle-warning)))\n'
      printf '  (let ((*standard-output* (make-broadcast-stream)))\n'
      printf '    (asdf:load-system :glass-sdl)))\n\n'
      # THE DENSITY IS ASKED BEFORE THE SESSION IS MADE, not after the window opens.  A
      # viewer only learns its display's scale when it has a window, and by then the apps
      # below have already been spawned at whatever ppem they were handed -- a terminal
      # booted at 1x with sharp chrome around small text.  DISPLAY-SCALE measures with a
      # 1x1 hidden window and throws it away, so the session is built knowing.  An
      # ordinary display answers 1 and nothing changes.
      printf '(let* ((scale (glass-sdl:display-scale))\n'
      printf '       (p (clim-glass:make-wm-session :width (round (* %s scale))\n' "$w"
      printf '                                      :height (round (* %s scale))\n' "$h"
      printf '                                      :scale scale'
      [[ -n $wallpaper ]] && printf ' :background "%s" :background-mode :cover' "$wallpaper"
      printf ')))\n'
      printf '  (clim-glass:start-wm-session p (list'
      local a; local IFS=,
      for a in $apps; do
        [[ -z $a ]] && continue
        if [[ $a == terminal ]]; then printf ' (list :terminal :cols 80 :rows 24 :ppem 14)'
        else printf ' (list (let ((*package* (find-package :clim-glass))) (read-from-string "%s")))' "$a"; fi
      done
      unset IFS
      printf '))\n'
      printf '  (sb-thread:make-thread (lambda () (clim-glass:run-wm-loop p)) :name "kiln-wm")\n'
      printf '  (format t "~&kiln: window   one image, no wire~%%")\n'
      printf '  (finish-output)\n'
      # CLOSING THE WINDOW ENDS THE SESSION.  VIEW returns when the window closes, and
      # without this the image would sit there with a compositor thread still running and
      # a REPL on stdin — a desktop nobody can see, still holding its session lock.  The
      # window IS the desktop in this mode, so closing it is not "detach", it is "stop".
      printf '  (unwind-protect (glass-sdl:view :seat (clim-glass:port-seat p))\n'
      printf '    (format t "~&kiln: window closed — stopping ~a~%%" *kiln-session-name*)\n'
      printf '    (finish-output)\n'
      printf '    ;; EXIT runs the exit hooks, which is what puts the session lock back.\n'
      printf '    (sb-ext:exit :code 0)))\n'
    elif [[ -n $vnc || -n $vnc_sock ]]; then
      local w=1280 h=800
      [[ -n $size ]] && { w=${size%%x*}; h=${size##*x}; }
      printf '(clim-glass:run-wm\n  (list'
      local a; local IFS=,
      for a in $apps; do
        [[ -z $a ]] && continue
        if [[ $a == terminal ]]; then printf ' (list :terminal :cols 80 :rows 24 :ppem 14)'
        else printf ' (list (let ((*package* (find-package :clim-glass))) (read-from-string "%s")))' "$a"; fi
      done
      unset IFS
      printf ')\n  :width %s :height %s\n' "$w" "$h"
      [[ -n $wallpaper ]] && printf '  :background "%s" :background-mode :cover\n' "$wallpaper"
      if [[ -n $vnc_sock ]]; then
        local sp=$vnc_sock
        [[ $sp == auto ]] && printf '  :kind :rfb-unix :path (glass:socket-path "kiln-%s.rfb")\n' "$display" \
                          || printf '  :kind :rfb-unix :path "%s"\n' "$sp"
      else
        local vp=$vnc; [[ $vp == auto ]] && vp=$((5900 + display))
        printf '  :port %s :address "%s"\n' "$vp" "$addr"
      fi
      printf '  )\n'
    else
      # Nothing blocking was asked for.  If services are running, park; if not,
      # fall off the end into the REPL, which is the whole point of the default.
      if [[ -n $control || -n $audio || -n $gateway || -n $sshd ]]; then
        printf '(format t "~&kiln: no screen — parking (^C to stop)~%%")\n'
        printf '(loop (sleep 5))\n'
      fi
    fi
  } > "$boot"

  # nostr is an RFB CLIENT of this desktop, so it needs a wire to reach it.  --view is
  # a desktop with NO wire, which is its whole point -- so it cannot carry nostr, and
  # saying so here beats a gateway that starts and then cannot find a screen.
  if [[ -n $nostr && -z $vnc && -z $vnc_sock ]]; then
    die "--nostr needs a wire to the screen: add --vnc-socket (or --vnc). --view has none by design."
  fi

  if [[ -z $vnc && -z $vnc_sock && -z $view && -z $control && -z $audio && -z $gateway && -z $nostr && -z $sshd ]]; then
    note "nothing enabled — the image and a REPL on stdin/stdout"
    note "ask for something:  --view  --vnc  --vnc-socket  --control  --audio"
    note "                    --gateway  --nostr"
    note "                    --apps=terminal  --size=WxH  --wallpaper=P  --voice=P"
    exec_local "" "$display" "$addr" "" ""
  fi

  if [[ -n $view ]]; then
    note "desktop :$display — one image, no container, no wire: a window on this screen"
  elif [[ -n $vnc || -n $vnc_sock ]]; then
    note "desktop :$display — one image, no container, no isolation"
  else
    note "no screen — services only, on display :$display"
  fi
  [[ -n $expose ]] && note "EXPOSED on 0.0.0.0 — every interface, because --expose"
  exec_local "$boot" "$display" "$addr" "$gateway" "$gateway_id"
}

local_usage() {
  cat >&2 <<'USAGE'
kiln local [flags] — run the desktop on this machine, no container.

  Nothing is enabled by default.  A bare `kiln local' is the core and a REPL on
  stdin/stdout: every capability below is something you ask for by name, and the
  boot file kiln generates contains only what you asked for.

  --view               open the desktop in a window HERE, with no wire at all
  --vnc[=PORT]         serve the screen over RFB (default 5900+display)
  --vnc-socket[=PATH]  serve the screen on a UNIX socket instead (no port)
  --control[=PORT|PATH] eval control socket; bare gives a 0600 socket file
  --audio[=PORT]       session audio mixer
  --apps=LIST          startup windows: terminal, or McCLIM frame classes
  --size=WxH           screen size (default 1280x800)
  --wallpaper=PATH     desktop wallpaper
  --voice=PATH         text-to-speech voice graph (chord)
  --ears=PATH          speech recognizer models (stave)
  --gateway[=PORT]     the browser gateway (an HTTP server)
  --detach, -d         run it in the background and give the terminal back.  The
                       session's name is printed once it has picked one; the log is
                       $KILN_STATE/session-N.log.
  --resume[=NAME]      resume a session instead of starting a new one — same nsec, so
                       links already issued still verify and enrolled devices stay
                       enrolled.  Bare --resume takes the only idle session there is,
                       and lists them rather than guessing when there is a choice.
  --nostr[=WHO]        signalling over nostr relays — for reaching this session when it
                       is NOT the machine you are sitting at.  WHO is an npub, 64-hex,
                       or a NIP-05 name@domain: it becomes the allowlist AND gets a
                       login link DM'd to it when the session comes up, so one command
                       is the whole of "start a desktop and let me in from my phone".
                       Bare --nostr leaves the allowlist to the .config and messages
                       nobody.

                       Needs a wire to the screen (--vnc-socket or --vnc), because the
                       gateway is an RFB client of it.  Two cautions, both real: `kiln
                       local' has none of the container's isolation, and a session is
                       an identity — two of them on one npub is the thing --resume
                       exists to avoid.
  --gateway-id=ID      gateway identity
  --display=N          display number (ports derive from it)
  --expose             bind 0.0.0.0 instead of loopback
  --ssh                the ssh control plane (needs a host key in KILN_ETC)
  --config=FILE        load an existing config file; skip generation entirely
  --rebuild            re-dump the core first
USAGE
}

exec_local() {
  local boot=$1 display=$2 addr=$3 gw=$4 gwid=$5
  local -a envv=(MODUS_ROOT="$KILN_ROOT" KILN_HOME="$ROOT" KILN_ETC="$KILN_ETC"
                 GLASS_DISPLAY="$display" GLASS_BIND="$addr")
  [[ -n $gwid ]] && envv+=(GW_ID="$gwid")
  [[ -n ${KILN_SSHD:-} ]] && envv+=(KILN_SSHD="$KILN_SSHD")
  [[ -n ${KILN_RESUME:-} ]] && envv+=(KILN_RESUME="$KILN_RESUME")
  local -a cmd=(sbcl --core "$LOCAL_CORE" --control-stack-size 256
                --dynamic-space-size "${KILN_HEAP:-4096}")
  [[ -n $boot ]] && cmd+=(--load "$boot")

  # DETACHED, because a desktop is not a command you are waiting on.  `kiln run' has
  # always been detached — the engine does it — and `kiln local' blocked the terminal
  # that started it, which is a difference between the two paths and not between the
  # two desktops.
  if [[ -n ${DETACH:-} ]]; then
    local log="$KILN_STATE/session-$display.log"
    : > "$log"
    nohup env "${envv[@]}" "${cmd[@]}" >>"$log" 2>&1 &
    local pid=$!
    note "detached — pid $pid, log $log"
    # THE NAME IS DECIDED IN LISP, not here: the session mints its key and reads its own
    # name off it, so the only way to report it is to wait for it to say so.  A few
    # seconds, then give up and point at the log rather than hanging on a boot that
    # failed.
    local i
    for i in $(seq 1 60); do
      # Either spelling: one.lisp (the container boot) says "@@ session", the boot file
      # generated here says "kiln: session".  Matching only one meant a session that had
      # already named itself was reported as still starting.
      if grep -qE "^(@@|kiln:) session " "$log" 2>/dev/null; then
        grep -m1 -E "^(@@|kiln:) session " "$log" | sed 's/^@@ /kiln: /'
        grep -m1 -E "npub1[a-z0-9]+" "$log" 2>/dev/null | sed -E 's/^[@k].*(npub1[a-z0-9]+).*/kiln:          \1/'
        return 0
      fi
      kill -0 "$pid" 2>/dev/null || { note "it exited — see $log"; tail -5 "$log" >&2; return 1; }
      sleep 0.5
    done
    note "still starting — watch $log"
    return 0
  fi
  exec env "${envv[@]}" "${cmd[@]}"
}

# ---- a folder you can move ---------------------------------------------------

cmd_bundle() {
  local zip="" out="$PWD/kiln-bundle" full=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --zip) zip=1 ;;
      --full) full=1 ;;
      --out) out=$2; shift ;;
      *) die "bundle: unknown option $1" ;;
    esac
    shift
  done
  [[ -d $KILN_ROOT/glass ]] || die "no checkouts at $KILN_ROOT to bundle"
  note "bundling from $KILN_ROOT -> $out"
  rm -rf "$out"; mkdir -p "$out/repos"

  # Excluded by default: version control, build artifacts, and the external
  # conformance corpora, which are most of the bytes and none of the desktop.
  # --full keeps everything.
  local ex=(--exclude ".git")
  [[ -z $full ]] && ex+=(--exclude "*.core"
                        --exclude "test262-full" --exclude "wpt"
                        --exclude "ansi-test" --exclude "modus-ref"
                        --exclude "inspect/vectors" --exclude "inspect/*.png")
  local n=0
  while read -r name branch commit; do
    case "$name" in \#*|"") continue ;; esac
    [[ -d $KILN_ROOT/$name ]] || { note "  skipping $name (not checked out)"; continue; }
    rsync -a ${ex[@]+"${ex[@]}"} "$KILN_ROOT/$name/" "$out/repos/$name/" 2>/dev/null || \
      die "rsync failed for $name"
    n=$((n+1))
  done < "$ROOT/repos.lock"
  cp "$ROOT/repos.lock" "$out/repos.lock"
  mkdir -p "$out/boot"; cp "$ROOT/boot/build.lisp" "$ROOT/boot/one.lisp" "$out/boot/"

  cat > "$out/kiln-run" <<'LAUNCH'
#!/usr/bin/env bash
# kiln-run — start the desktop from this bundle, on this machine's SBCL.
#
# No container: this is your user and your ports.  The first run builds a core
# (McCLIM takes a few minutes); after that it starts in about a second.
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$HERE/repos
CORE=$HERE/modus.core
DISPLAY_N=${GLASS_DISPLAY:-1}

command -v sbcl >/dev/null || { echo "kiln: no sbcl on PATH" >&2; exit 1; }
[ -f "$HOME/quicklisp/setup.lisp" ] || {
  echo "kiln: needs Quicklisp at ~/quicklisp (the desktop uses McCLIM)" >&2; exit 1; }

if [ ! -f "$CORE" ]; then
  echo "kiln: building the core, once — McCLIM takes a few minutes" >&2
  KILN_SOURCE_TREE="$ROOT" KILN_CORE="$CORE"     sbcl --dynamic-space-size 4096 --script "$HERE/boot/build.lisp"
fi

echo "kiln: desktop :$DISPLAY_N  ->  vnc://127.0.0.1:$((5900 + DISPLAY_N))" >&2
exec sbcl --core "$CORE" --control-stack-size 256 --dynamic-space-size "${KILN_HEAP:-4096}"      --load "$ROOT/glass/backend/inspect/serve-desktop.lisp"
LAUNCH
  chmod +x "$out/kiln-run"

  cat > "$out/README" <<'RM'
The modus-lisp desktop, as a folder.

    ./kiln-run                 vnc://127.0.0.1:5901
    GLASS_DISPLAY=3 ./kiln-run  ... on 5903 instead

Needs SBCL and a Quicklisp at ~/quicklisp (McCLIM comes from there).  The first
run compiles and dumps modus.core beside this file; later runs reuse it.

This is NOT the container.  It is your user, your files and your ports, and the
desktop's terminal is a shell as you.  What you get instead is that there is
nothing between you and the process: the sources are right here in repos/, and
editing one is live on the next start.

repos.lock records the commit every repo was taken from.
RM

  local size
  size=$(find "$out" -type f -print0 | xargs -0 stat -f%z 2>/dev/null | awk '{s+=$1} END {printf "%.0f", s/1048576}')
  note "$n repos, ${size} MB -> $out"
  if [[ -n $zip ]]; then
    note "zipping"
    (cd "$(dirname "$out")" && zip -qr "$(basename "$out").zip" "$(basename "$out")")
    note "$(dirname "$out")/$(basename "$out").zip"
  fi
}

# The box's identity and the keys allowed to configure it.  Generated on the
# HOST, with ssh-keygen, and mounted in — so the container never has to invent a
# credential, the host key is stable across rebuilds (known_hosts stays quiet),
# and you can read exactly what is trusted with cat.
# KILN_MOUNT_REPOS="conch glass" bind-mounts those local checkouts over the
# image's cloned copies, so uncommitted work can be tested without a push and a
# repin.  Development only — the image alone is no longer self-contained.
# KILN_MOUNT_BOOT=1 does the same for kiln's own boot files (entrypoint.sh,
# one.lisp, config.lisp), which are COPYed into the image rather than cloned --
# so without it, changing how the image BOOTS costs a full rebuild to try once.
#
# Either of those means SOURCE NEWER THAN THE CORE, so ASDF recompiles it -- and the
# rootfs is read-only, including the fasl cache under $HOME.  KILN_DEV_CACHE=1 puts a
# tmpfs there so the recompile has somewhere to land.
#
# It is a tmpfs OVER THE DEFAULT PATH rather than a redirect (ASDF_OUTPUT_TRANSLATIONS)
# on purpose.  Re-pointing ASDF's output at boot makes every fasl in the saved core
# look missing, so it rebuilds systems the image already has LOADED -- and recompiling
# a struct that live code is holding instances of is fatal: "attempt to redefine the
# STRUCTURE-OBJECT class 3BZ::CONTEXT-BOXES incompatibly".  Keep the path, add the
# writability.
mount_repo_args() {
  local args=() repo
  for repo in $KILN_MOUNT_REPOS; do
    args+=(-v "$ROOT/../$repo:/opt/modus-lisp/$repo")
  done
  printf '%s\n' "${args[@]}"
}

ensure_etc() {
  mkdir -p "$KILN_ETC"
  chmod 700 "$KILN_ETC"
  if [[ ! -f $KILN_ETC/host_ed25519 ]]; then
    note "generating the box's SSH host key (once)"
    ssh-keygen -q -t ed25519 -N '' -C "kiln-box" -f "$KILN_ETC/host_ed25519"
  fi
  if [[ ! -s $KILN_ETC/authorized_keys ]]; then
    local pub=${KILN_AUTHORIZED_KEY:-}
    if [[ -z $pub ]]; then
      # conch verifies ssh-ed25519 only, so an RSA key here would be accepted by
      # the file and rejected at login — better to say so now.
      for cand in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do
        [[ -f $cand ]] && { pub=$(cat "$cand"); break; }
      done
    fi
    [[ -n $pub ]] || die "no ssh public key found.
  kiln authenticates its config TUI with YOUR key, and needs one to trust.
  Make one:            ssh-keygen -t ed25519
  or name one:         KILN_AUTHORIZED_KEY=\"\$(cat some_key.pub)\" kiln config"
    [[ $pub == ssh-ed25519* ]] || die "kiln needs an ssh-ed25519 key (conch verifies only that type).
  Found: ${pub%% *}.  Make one with:  ssh-keygen -t ed25519"
    printf '%s\n' "$pub" > "$KILN_ETC/authorized_keys"
    chmod 600 "$KILN_ETC/authorized_keys"
    note "trusting $(printf '%s' "$pub" | awk '{print $3}')"
  fi
}

# Configure the box the way you would configure a kernel: ssh in with the key you
# already have, and get a menuconfig.
cmd_config() {
  ensure_etc
  running || cmd_run
  # The control plane comes up beside the desktop; give it a moment on first boot.
  # Read the banner, do not merely connect: Apple's published-port proxy accepts
  # before anything inside is listening, so a bare `nc -z` says yes to a dead
  # port and ssh then dies with "Connection reset by peer".  SSH servers speak
  # first ("SSH-2.0-..."), which is a real liveness test.
  local up=""
  for _ in $(seq 1 90); do
    if [[ $(nc -w 2 127.0.0.1 "$SSH_PORT" 2>/dev/null | head -c 4) == SSH- ]]; then
      up=1; break
    fi
    sleep 1
  done
  [[ -n $up ]] || die "the SSH control plane never came up on $SSH_PORT (kiln logs)"
  note "connecting to the config TUI"
  # A pty is the point (it is a full-screen TUI), and the host key is kiln's own,
  # kept in $KILN_ETC — checked against a known_hosts file of its own so it never
  # argues with your real one.
  exec ssh -t -p "$SSH_PORT" \
       -i "${KILN_SSH_KEY:-$HOME/.ssh/id_ed25519}" \
       -o UserKnownHostsFile="$KILN_ETC/known_hosts" \
       -o StrictHostKeyChecking=accept-new \
       -o LogLevel=ERROR \
       kiln@127.0.0.1
}

# A native window onto the desktop — no browser, no VNC client.
#
# glass-sdl is the one FFI in the workspace, and this is where it belongs: glass
# is a framebuffer and an RFB server in Common Lisp, but putting its pixels on a
# screen means asking somebody else's window server, and on a hosted OS that is
# always C.  Runs HERE, on your machine, against the desktop wherever it is.
cmd_view() {
  command -v sbcl >/dev/null || die "kiln view needs sbcl on this machine"
  [[ -d $KILN_ROOT/glass-sdl ]] || die "no glass-sdl at $KILN_ROOT/glass-sdl"
  KILN_VNC=1; export KILN_VNC
  if running && ! [[ $(nc -w 2 127.0.0.1 "$VNC_PORT" 2>/dev/null | head -c 3) == RFB ]]; then
    note "restarting to publish $VNC_PORT"
    cmd_stop >/dev/null
  fi
  running || cmd_run
  for _ in $(seq 1 90); do
    [[ $(nc -w 2 127.0.0.1 "$VNC_PORT" 2>/dev/null | head -c 3) == RFB ]] && break
    sleep 1
  done
  note "opening a native window on 127.0.0.1:$VNC_PORT"
  exec sbcl --dynamic-space-size 2048 --disable-debugger --non-interactive \
    --eval "(require :asdf)" \
    --eval "(asdf:initialize-source-registry '(:source-registry (:tree #p\"$KILN_ROOT/\") (:exclude \"vendor\" \"deps\") :inherit-configuration))" \
    --eval "(handler-bind ((warning (function muffle-warning))) (let ((*standard-output* (make-broadcast-stream))) (asdf:load-system :glass-sdl)))" \
    --eval "(glass-sdl:view :host \"127.0.0.1\" :port $VNC_PORT)"
}

cmd_web() {
  KILN_WEB=1 MODE=web
  export KILN_WEB
  running || cmd_run
  local url="http://localhost:$GW_PORT/"
  note "opening $url"
  [[ $(uname -s) == Darwin ]] && open "$url" || note "point a browser at $url"
}

# ...and the screen must bind the container's OWN interface for a published port to
# reach it.  glass binds 127.0.0.1 by default, correctly -- but a published port
# arrives on eth0, so forwarding to a loopback-bound server delivers to nothing, and
# Apple's proxy accepts first so the viewer sees an open port and an empty stream.
# 0.0.0.0 is every interface OF THE CONTAINER, which is not the LAN: the host side is
# still published to 127.0.0.1 unless KILN_EXPOSE says otherwise.
#
# RFB is NOT published by default.  The desktop does not even LISTEN on a port by
# default now -- the screen is a socket file, and KILN_VNC is what puts it back on
# 5900+N, which is why the variable has to reach the container and not merely open a
# hole in front of it.  Publishing without it forwards to nothing, and Apple's port
# proxy accepts anyway, so the viewer connects and reads no banner at all. This
# turns it on, and it is a real widening: RFB's own auth is DES over a password
# truncated to eight characters, so the honest posture is off unless asked for.
cmd_vnc() {
  KILN_VNC=1; export KILN_VNC
  if running && ! nc -z -w2 127.0.0.1 "$VNC_PORT" 2>/dev/null; then
    note "restarting to publish $VNC_PORT"
    cmd_stop >/dev/null
  fi
  running || cmd_run
  local url="vnc://127.0.0.1:$VNC_PORT"
  if [[ $(uname -s) == Darwin ]]; then
    note "opening $url"; open "$url"
  else
    note "point a VNC client at $url"
  fi
}

cmd_stop() {
  ensure_engine_up
  running && { "$ENGINE" stop "$NAME" >/dev/null 2>&1 || true; note "stopped"; }
  exists  && { "$ENGINE" rm "$NAME"   >/dev/null 2>&1 || true; note "removed"; }
  true
}

# Apple's CLI spells this `image list`; docker and podman spell it `images`.
image_built() {
  local out
  if [[ $ENGINE == container ]]; then
    out=$(container image list 2>/dev/null)
  else
    out=$("$ENGINE" images 2>/dev/null)
  fi
  grep -q "${IMAGE%%:*}" <<<"$out"
}

cmd_status() {
  ensure_engine_up
  printf 'engine     %s\n' "$ENGINE"
  printf 'image      %s%s\n' "$IMAGE" \
    "$(image_built && echo '  (built)' || echo '  (not built — run: kiln build)')"
  printf 'container  %s  %s\n' "$NAME" "$(running && echo running || { exists && echo stopped || echo absent; })"
  printf 'display    :%s  vnc %s  audio %s  control %s\n' "$DISPLAY_N" "$VNC_PORT" "$AUDIO_PORT" "$CTRL_PORT"
}

cmd_logs()  { ensure_engine_up; "$ENGINE" logs "$@" "$NAME"; }
cmd_shell() { running || die "not running (kiln run)"; "$ENGINE" exec -ti "$NAME" /bin/bash; }
cmd_repl()  { running || die "not running (kiln run)"; "$ENGINE" exec -ti "$NAME" /kiln/boot/entrypoint.sh repl; }

# Evaluate in the LIVE desktop through its control socket — the running image,
# not a fresh one, so you can read perf and poke at a desktop mid-session.
#
# Runs INSIDE the container rather than over a published port, because glass
# binds the control socket to 127.0.0.1 (as it should — it is an unauthenticated
# eval socket).  Loopback inside a container is not loopback outside it, so
# publishing 4009 would expose nothing and forward nowhere.  bash's /dev/tcp
# does the talking, which saves installing a netcat just for this.
# The control socket a LOCAL session opened, if it has one.
#
# READ OUT OF THE SESSION'S OWN LOG rather than recomputed.  The path comes from
# GLASS:SOCKET-PATH and the runtime directory it picks is glass's business, not this script's
# — guessing it here means two places that must agree about something only one of them
# decides, and the first version of this guessed $TMPDIR while glass had chosen ~/.glass/run.
# The session says where it put it; believe the session.
local_control_socket() {
  local log="$KILN_STATE/session-$DISPLAY_N.log" p=""
  [[ -f $log ]] && p=$(sed -n 's/^kiln: control  *//p' "$log" | tail -1)
  [[ -n $p ]] && { echo "$p"; return; }
  # Nothing said, so fall back to where glass puts things by default.  Only reached for a
  # session started without --control, where the answer is that there is no socket.
  echo "${XDG_RUNTIME_DIR:-$HOME/.glass/run}/kiln-${DISPLAY_N}.control"
}

cmd_eval() {
  [[ $# -gt 0 ]] || die "eval needs a form, e.g. kiln eval '(glass:perf-report)'"

  # A LOCAL SESSION FIRST, because `kiln desktop' is now the common way to have one and it is
  # not a container.  This used to go straight to the engine and report "not running" for a
  # desktop that was plainly on the screen — true about a container, and the wrong answer to
  # the question, which was about a desktop.
  local sock; sock=$(local_control_socket)
  if [[ -S $sock ]]; then
    command -v nc >/dev/null 2>&1 || die "eval over a socket needs nc"
    printf '%s\n' "$1" | nc -U "$sock" 2>/dev/null
    return
  fi

  running || die "no desktop to talk to — none running locally (kiln desktop) and no container (kiln run)"
  "$ENGINE" exec "$NAME" bash -c '
      exec 3<>/dev/tcp/127.0.0.1/'"$CTRL_PORT"' || exit 1
      printf "%s\n" "$1" >&3
      timeout 10 cat <&3' _ "$1"
}

# The sessions on this machine, and which of them are running.  A session IS its
# identity, so this is also the answer to "which npub is that desktop".
cmd_sessions() {
  host_prereqs
  # Reading the list needs cl-nostr (to turn each nsec into an npub), which is in the
  # core.  Building one just to list sessions would be absurd, so this asks for the core
  # that exists and says so plainly when there is not one yet.
  local core="${KILN_STATE}/modus.core"
  [[ -f $core ]] || die "no core yet — run kiln local once (it builds one), or kiln local --rebuild"
  local LOCAL_CORE=$core
  MODUS_ROOT="$KILN_ROOT" KILN_HOME="$ROOT" KILN_ETC="$KILN_ETC" \
  sbcl --core "$core" --noinform --non-interactive --disable-debugger \
       --eval "(load \"$ROOT/boot/session.lisp\")" \
       --eval '(progn (funcall (read-from-string "kiln-session-report") *standard-output*) (sb-ext:exit))' \
    2>/dev/null | sed 's/^@@ //'
}

cmd_test() { ensure_engine_up; set_dns_args; "$ENGINE" run --rm ${DNS_ARGS[@]+"${DNS_ARGS[@]}"} "$IMAGE" test; }

cmd_modus() {
  # modus-lisp's own Lisp, in the image, as an ordinary process.  Nothing is
  # mounted unless --work names it: running a REPL in a container is the same
  # argument as running anything else in one, and modus needs no host directory
  # to be useful.  The fences come from SET_FENCE_ARGS like every other container
  # here — they are the default now, not something a subcommand turns on.
  local work=""
  while [[ $# -gt 0 ]]; do
    local arg=$1 val=""
    [[ $arg == *=* ]] && { val=${arg#*=}; arg=${arg%%=*}; }
    case $arg in
      --work) work=${val:?--work=DIR} ;;
      --)     shift; break ;;
      -h|--help)
        cat >&2 <<'USAGE'
kiln modus [--work=DIR] [-- args…] — modus's own hosted Lisp, in the image.

  A REPL on stdin/stdout by default; SBCL-faithful flags pass straight through
  (--script FILE, --eval FORM, --load FILE, --non-interactive, --quit).

  --work=DIR   the one host directory it can see (default: none at all)

  NOT the desktop: that is mcclim-glass, and modus has no McCLIM.  For glass's
  RFB server on modus — which now loads, threads and listens — see
  `kiln modus-rfb PORT'.
USAGE
        return 0 ;;
      *) break ;;
    esac
    shift
  done
  ensure_engine_up
  set_dns_args
  set_fence_args
  local -a mounts=()
  if [[ -n $work ]]; then
    [[ -d $work ]] || die "no such directory: $work"
    work=$(cd -- "$work" && pwd)
    mounts=(-v "$work:/work" -w /work)
    note "workspace  $work"
  fi
  "$ENGINE" run --rm -it ${DNS_ARGS[@]+"${DNS_ARGS[@]}"} "${FENCE_ARGS[@]}" \
    ${mounts[@]+"${mounts[@]}"} "$IMAGE" modus "$@"
}

cmd_modus_rfb() {
  # glass's RFB server, running on MODUS instead of on SBCL, in the image.
  #
  # THE PORT IS AN ARGUMENT AND HAS NO DEFAULT, and that is the whole posture of
  # this command: a server that listens is a thing you ASK for, on a number you
  # name.  It is published to the host's LOOPBACK only — the same PUBLISH_ON the
  # rest of this script uses, so KILN_EXPOSE is the one deliberate widening and
  # it is the same one deliberate widening everywhere else.
  #
  # 5900-5920 is where a real desktop lives on a developer's box, so this REFUSES
  # that range rather than fighting `kiln run' for a port.
  local port="" work="" size=""
  while [[ $# -gt 0 ]]; do
    local arg=$1 val=""
    [[ $arg == *=* ]] && { val=${arg#*=}; arg=${arg%%=*}; }
    case $arg in
      --work) work=${val:?--work=DIR} ;;
      --size) size=${val:?--size=WxH} ;;
      --)     shift; break ;;
      -h|--help)
        cat >&2 <<'USAGE'
kiln modus-rfb PORT [--size=WxH] [--work=DIR] — glass's RFB server, on modus.

  PORT         required, no default, published on 127.0.0.1 only.
               5900-5920 is refused: that is where the SBCL desktop lives.
  --size=WxH   framebuffer size (default 1024x768)
  --work=DIR   the one host directory it can see (default: none at all)

  This is the :glass system — packages, record, framebuffer, clipboard, perf,
  socket, rfb, zrle, over cram — loaded by modus's own compiler at start, with
  glass's per-client reader AND sender threads on modus's threads.  It is NOT
  the desktop (mcclim-glass needs McCLIM; modus has none), so what a viewer
  sees is a framebuffer, not a window manager.

  THE BINARY IS BAKED INTO THE IMAGE.  Editing the modus checkout changes
  nothing until `kiln build' — the SBCL side reloads changed systems over the
  core on every start, and modus, being a static ELF with its compiler inside
  it, does not.
USAGE
        return 0 ;;
      *) [[ -z $port ]] && { port=$arg; shift; continue; }; break ;;
    esac
    shift
  done
  [[ -n $port ]] || die "kiln modus-rfb: needs a PORT (try --help)"
  [[ $port =~ ^[0-9]+$ ]] || die "kiln modus-rfb: PORT must be a number"
  (( port >= 1 && port <= 65535 )) || die "kiln modus-rfb: PORT out of range"
  (( port >= 5900 && port <= 5920 )) &&
    die "kiln modus-rfb: $port is inside 5900-5920, where the desktop lives — pick another"
  local -a env=()
  if [[ -n $size ]]; then
    [[ $size =~ ^([0-9]+)x([0-9]+)$ ]] || die "--size wants WxH, e.g. 1280x800"
    env=(-e "MODUS_RFB_W=${BASH_REMATCH[1]}" -e "MODUS_RFB_H=${BASH_REMATCH[2]}")
  fi
  ensure_engine_up
  set_dns_args
  set_fence_args
  local -a mounts=()
  if [[ -n $work ]]; then
    [[ -d $work ]] || die "no such directory: $work"
    work=$(cd -- "$work" && pwd)
    mounts=(-v "$work:/work" -w /work)
    note "workspace  $work"
  fi
  note "vnc://127.0.0.1:$port  (glass on modus; Ctrl-C to stop)"
  "$ENGINE" run --rm -it ${DNS_ARGS[@]+"${DNS_ARGS[@]}"} "${FENCE_ARGS[@]}" \
    ${env[@]+"${env[@]}"} ${mounts[@]+"${mounts[@]}"} \
    -p "${PUBLISH_ON}${port}:${port}" "$IMAGE" modus-rfb "$port"
}

cmd_lock() {
  # NO CONTAINER.  This reads each repo's info/refs through cairn — pure Common
  # Lisp git over seal's TLS, one HTTPS GET apiece, no GitHub API and so no token
  # and no rate limit.  That is the whole boast, and it was being made from inside
  # a container image that had to be BUILT first: refreshing a list of commits
  # required an engine, a build, and several minutes, to do something a host SBCL
  # does in seconds.  Same conflation as `kiln local' — the work never needed the
  # container, only the invocation did.
  host_prereqs
  note "reading the org's live refs with cairn (no container)"
  local tmp; tmp=$(mktemp)
  if MODUS_ROOT="$KILN_ROOT" KILN_LOCK="$ROOT/repos.lock" MODUS_ORG="${MODUS_ORG:-modus-lisp}" \
     sbcl --script "$ROOT/boot/lock.lisp" > "$tmp" 2>/dev/null && [[ -s $tmp ]]; then
    mv "$tmp" "$ROOT/repos.lock"
    note "repos.lock updated — rebuild to pick it up"
  else
    rm -f "$tmp"; die "lock produced no output; repos.lock left alone"
  fi
}

cmd_clean() {
  cmd_stop
  "$ENGINE" rmi "$IMAGE" >/dev/null 2>&1 || "$ENGINE" image rm "$IMAGE" >/dev/null 2>&1 || true
  note "image removed"
}

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; $d'; }

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  run)   shift
         # --resume here rather than inside cmd_run: it is an ENVIRONMENT for the
         # container, not an engine flag, and everything else cmd_run takes is passed
         # through to the engine verbatim.
         while [[ $# -gt 0 ]]; do
           case "$1" in
             --resume)   KILN_RESUME=1; export KILN_RESUME; shift ;;
             --resume=*) KILN_RESUME=${1#*=}; export KILN_RESUME; shift ;;
             # An identity, or bare for "on, allowlist from the .config".  It reaches
             # one.lisp as KILN_NOSTR, which is the same variable the config sets — so
             # the flag and the file say the same thing in the same place.
             --nostr)    KILN_NOSTR=1; export KILN_NOSTR; shift ;;
             --nostr=*)  KILN_NOSTR=${1#*=}; export KILN_NOSTR; shift ;;
             *) break ;;
           esac
         done
         cmd_run "$@" ;;
  vnc)   shift; cmd_vnc ;;
  web)   shift; cmd_web ;;
  view)  shift; cmd_view ;;
  sessions) shift; cmd_sessions ;;
  config) shift; cmd_config ;;
  local)  shift; cmd_local "$@" ;;
  bundle) shift; cmd_bundle "$@" ;;
  stop)  shift; cmd_stop ;;
  status)shift; cmd_status ;;
  logs)  shift; cmd_logs "$@" ;;
  shell) shift; cmd_shell ;;
  repl)  shift; cmd_repl ;;
  eval)  shift; cmd_eval "$@" ;;
  test)  shift; cmd_test ;;
  modus) shift; cmd_modus "$@" ;;
  modus-rfb) shift; cmd_modus_rfb "$@" ;;
  desktop) shift; cmd_desktop "$@" ;;
  profiles) shift; cmd_profiles ;;
  models) shift; cmd_models "$@" ;;
  lock)  shift; cmd_lock ;;
  clean) shift; cmd_clean ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
