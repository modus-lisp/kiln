#!/usr/bin/env bash
# kiln — build and run the modus-lisp desktop image.
#
# Speaks to whichever container engine is present: Apple's `container` (the
# default on Apple silicon), docker, or podman.  Force one with KILN_ENGINE.
#
#   kiln build            build the image (first run: coffee)
#   kiln run              start the desktop, print the VNC address
#   kiln web              open the browser client (the default surface)
#   kiln config           ssh in with your own key and configure the box (menuconfig)
#   kiln local            run on THIS machine, no container (no isolation either)
#   kiln bundle [--zip]   pack the sources + a launcher into a movable folder
#   kiln vnc              ALSO publish RFB and open a VNC client (off by default)
#   kiln stop             stop and remove the container
#   kiln status           engine, image, container, ports
#   kiln logs [-f]        container logs
#   kiln shell            a bash prompt inside the running desktop
#   kiln repl             an SBCL repl with the whole world already loaded
#   kiln eval '(form)'    evaluate a form in the RUNNING desktop, live
#   kiln test             glass's RFB self-test, in a throwaway container
#   kiln lock             refresh repos.lock from the org's live refs
#   kiln clean            remove the container and the image
#
# Env: KILN_ENGINE, KILN_IMAGE, KILN_NAME, KILN_DNS, KILN_HEAP,
#      GLASS_DISPLAY, GLASS_APPS, GLASS_VOICE, GLASS_EARS.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
IMAGE=${KILN_IMAGE:-modus-lisp/kiln}
NAME=${KILN_NAME:-kiln}
DISPLAY_N=${GLASS_DISPLAY:-1}

VNC_PORT=$((5900 + DISPLAY_N))
AUDIO_PORT=$((5910 + DISPLAY_N))
CTRL_PORT=$((4008 + DISPLAY_N))
GW_PORT=${GW_PORT:-8765}
# Two SBCLs share this container on the web path (desktop + gateway), and the
# engine's default is 1 GB.
KILN_MEM=${KILN_MEM:-4G}
SSH_PORT=${KILN_SSH_PORT:-2222}
# Everything that must outlive an image rebuild: the box's SSH host key, the keys
# allowed to configure it, and the .config the TUI writes.
KILN_ETC=${KILN_ETC:-$HOME/.kiln}
# Where the sibling checkouts live when running WITHOUT a container.  kiln sits
# among them, so its parent is the default.
KILN_ROOT=${KILN_ROOT:-$(cd -- "$ROOT/.." && pwd)}

die() { printf 'kiln: %s\n' "$*" >&2; exit 1; }
note() { printf '\033[36mkiln:\033[0m %s\n' "$*" >&2; }

# ------------------------------------------------------------------- engine

detect_engine() {
  if [[ -n ${KILN_ENGINE:-} ]]; then echo "$KILN_ENGINE"; return; fi
  # Apple's container is preferred on macOS: it is the native VM story here.
  if [[ $(uname -s) == Darwin ]] && command -v container >/dev/null; then
    echo container; return
  fi
  for e in docker podman container; do
    command -v "$e" >/dev/null && { echo "$e"; return; }
  done
  die "no container engine found (install Apple container, docker, or podman)"
}

ENGINE=$(detect_engine)
command -v "$ENGINE" >/dev/null || die "engine '$ENGINE' is not on PATH"

# Apple's container needs its system service up, and says so rather than
# starting itself.  Starting it for the user is the whole point of a driver.
ensure_engine_up() {
  [[ $ENGINE == container ]] || return 0
  if ! container ls >/dev/null 2>&1; then
    note "starting the container system service"
    container system start >/dev/null 2>&1 \
      || die "could not start the container service — try: container system start"
  fi
}

# A fresh Apple container install has no guest kernel, and there is no way to
# ASK whether one is configured — `container system kernel` only has `set`.  So
# this is reactive: run the command, and if it failed for exactly that reason,
# install the kernel once and try again.  One download per machine, and the
# difference between `kiln build` working and `kiln build` sending you to a
# manual page.
with_kernel() {
  local log rc
  log=$(mktemp); rc=0
  "$@" 2>&1 | tee "$log" || rc=${PIPESTATUS[0]}
  if grep -q "kernel not configured" "$log"; then
    rm -f "$log"
    note "no guest kernel configured — installing the recommended one (one time)"
    container system kernel set --recommended \
      || die "could not install a kernel — try: container system kernel set --recommended"
    note "retrying"
    "$@"
    return
  fi
  rm -f "$log"
  return "$rc"
}

# Apple's guests are handed the vmnet gateway as their resolver, and on a good
# number of Macs it does not answer — apt, the seed fetch and Quicklisp all die
# with "Temporary failure resolving".  So pass an explicit one.
#
# The host's own resolver is used when a guest could actually reach it, which on
# macOS is often false: a Mac running mDNSResponder or a VPN client advertises a
# loopback address, and 127.x means something different inside the VM.  In that
# case fall back to a public resolver.  KILN_DNS overrides the lot.
DNS_ARGS=()
set_dns_args() {
  [[ $ENGINE == container ]] || return 0
  local ns=${KILN_DNS:-}
  if [[ -z $ns ]]; then
    ns=$(scutil --dns 2>/dev/null | awk '/nameserver\[0\]/ {print $3; exit}' || true)
    [[ -z $ns || $ns == 127.* ]] && ns=1.1.1.1
  fi
  DNS_ARGS=(--dns "$ns")
}

running() { ensure_engine_up; "$ENGINE" ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$NAME"; }
exists()  { ensure_engine_up; "$ENGINE" ls --all 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$NAME"; }

# ------------------------------------------------------------------ actions

cmd_build() {
  ensure_engine_up
  note "building $IMAGE with $ENGINE (this compiles McCLIM once; expect several minutes)"
  set_dns_args
  if [[ $ENGINE == container ]]; then
    with_kernel container build "${DNS_ARGS[@]}" -t "$IMAGE" "$@" "$ROOT"
  else
    "$ENGINE" build -t "$IMAGE" "$@" "$ROOT"
  fi
  note "built $IMAGE"
}

# MODE is the entrypoint command.  "web" — the desktop plus the browser gateway —
# is the default, because the gateway is the surface that can actually be
# authenticated.  "desktop" is VNC only.
MODE=${MODE:-web}

cmd_run() {
  ensure_engine_up
  running && { note "already running"; cmd_address; return; }
  exists  && "$ENGINE" rm "$NAME" >/dev/null 2>&1 || true
  note "starting the desktop"
  set_dns_args
  "$ENGINE" run -d --name "$NAME" "${DNS_ARGS[@]}" \
    -e GLASS_DISPLAY="$DISPLAY_N" \
    ${KILN_HEAP:+-e KILN_HEAP="$KILN_HEAP"} \
    ${GLASS_APPS:+-e GLASS_APPS="$GLASS_APPS"} \
    ${GLASS_VOICE:+-e GLASS_VOICE="$GLASS_VOICE"} \
    ${GLASS_EARS:+-e GLASS_EARS="$GLASS_EARS"} \
    -m "$KILN_MEM" \
    -p "$GW_PORT:$GW_PORT" \
    -p "$SSH_PORT:$SSH_PORT" \
    -v "$KILN_ETC:/etc/kiln" \
    ${KILN_MOUNT_REPOS:+$(mount_repo_args)} \
    -e KILN_SSH_PORT="$SSH_PORT" \
    ${KILN_VNC:+-p "$VNC_PORT:$VNC_PORT"} \
    "$@" "$IMAGE" "$MODE" >/dev/null
  # The desktop compiles nothing at startup, but the RFB listener still needs a
  # moment; polling beats a fixed sleep.
  for _ in $(seq 1 40); do
    host_reachable && break
    sleep 0.25
  done
  cmd_address
}

host_reachable() {
  # A VNC client connects to whatever the engine published; check that.
  #
  # NOT bash's /dev/tcp: macOS ships bash 3.2 built without net-redirections, so
  # there it fails on every port, open or not — a check that always says "no" is
  # worse than no check.  nc is present on macOS and on the distros this runs on.
  #
  # And not a bare connect test either: Apple's container publishes ports through
  # a host-side proxy that ACCEPTS before anything inside is listening, so `nc -z`
  # reports success against a dead port.  RFB servers announce themselves first
  # ("RFB 003.008\n"), so reading the banner is what actually proves a server.
  [[ $(nc -w 3 127.0.0.1 "$VNC_PORT" 2>/dev/null | head -c 3) == RFB ]]
}

cmd_address() {
  local ip=""
  if [[ $ENGINE == container ]]; then
    ip=$(container inspect "$NAME" 2>/dev/null \
         | grep -oE '"(address|ipv4)"[^,]*' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
  fi

  # Only the screen is published.  glass binds the session audio and the control
  # socket to loopback inside the container, so they are reached from in there —
  # `kiln eval` does exactly that.
  note "browser  http://localhost:$GW_PORT/"
  if [[ -n ${KILN_VNC:-} ]]; then
    note "VNC      vnc://127.0.0.1:$VNC_PORT  (exposed by request)"
  else
    note "VNC      not published — container-local only (kiln vnc to expose)"
  fi
  note "config   kiln config    (ssh, your own key)"
  note "control  kiln eval '(glass:perf-report)'"
  note "audio    container-local on $AUDIO_PORT (glass binds it to loopback)"
}

# The browser path: noVNC over a WebRTC data channel, served from the container.
#
# No TLS, no certificate, no signalling relay and no TURN — because the port is
# published to the HOST'S LOOPBACK, and http://localhost is a secure context.
# Verified in Safari: isSecureContext, RTCPeerConnection, data channels and even
# getUserMedia all pass there.  The Nostr gateway beside this one solves a
# different problem — reaching a box that ISN'T the machine you are sitting at.
# ---- running on this machine, no container ---------------------------------
#
# The container buys isolation: the desktop's terminal is a root shell in a
# throwaway filesystem, and the ports it opens are the engine's to publish. None
# of that is true here -- `kiln local' is your user, your files, your ports. What
# it buys instead is that there is nothing to reason about: one SBCL process you
# can see in ps, reading the checkouts in place, so an edit is live on the next
# start with no image to rebuild.

host_prereqs() {
  command -v sbcl >/dev/null || die "no sbcl on PATH.
  kiln local runs on this machine's Lisp.  brew install sbcl, or use kiln run."
  [[ -f $HOME/quicklisp/setup.lisp ]] || die "no Quicklisp at ~/quicklisp.
  The desktop needs McCLIM, which comes from Quicklisp.  Install it from
  https://beta.quicklisp.org/quicklisp.lisp, or use kiln run."
  [[ -d $KILN_ROOT/glass ]] || die "no checkouts at $KILN_ROOT.
  kiln local reads the sibling repos in place; point KILN_ROOT at them, or
  unpack a bundle and run its own launcher."
}

# The core is what makes a start instant rather than a minute of McCLIM. Built
# once per machine, and only when missing -- editing a repo does NOT invalidate
# it, because ASDF still loads changed systems over the top on the next start.
# `kiln local --rebuild' is the button for when you want it re-dumped anyway.
ensure_local_core() {
  local core="$KILN_ETC/modus.core"
  if [[ -f $core && -z ${KILN_REBUILD:-} ]]; then LOCAL_CORE=$core; return; fi
  mkdir -p "$KILN_ETC"
  note "building a core for this machine (once; McCLIM takes a few minutes)"
  KILN_SOURCE_TREE="$KILN_ROOT" KILN_CORE="$core" \
    sbcl --dynamic-space-size 4096 --script "$ROOT/boot/build.lisp" || die "core build failed"
  LOCAL_CORE=$core
}

cmd_local() {
  [[ ${1:-} == --rebuild ]] && { KILN_REBUILD=1; shift; }
  host_prereqs
  ensure_local_core
  local display=${GLASS_DISPLAY:-1}
  local vnc=$((5900 + display)) gw=${GW_PORT:-8765}
  if nc -z -w2 127.0.0.1 "$vnc" 2>/dev/null; then
    die "something is already on $vnc (the container, perhaps: kiln stop).
  Or pick another display:  GLASS_DISPLAY=3 kiln local"
  fi
  note "desktop :$display on this machine — no container, no isolation"
  GLASS_DISPLAY=$display \
  sbcl --core "$LOCAL_CORE" --control-stack-size 256 --dynamic-space-size "${KILN_HEAP:-4096}" \
       --load "$KILN_ROOT/glass/backend/inspect/serve-desktop.lisp" &
  local desktop=$!
  trap 'kill $desktop 2>/dev/null' EXIT INT TERM
  for _ in $(seq 1 120); do
    [[ $(nc -w 2 127.0.0.1 "$vnc" 2>/dev/null | head -c 3) == RFB ]] && break
    sleep 0.5
  done
  note "VNC      vnc://127.0.0.1:$vnc"
  note "browser  http://localhost:$gw/  (starting)"
  GLASS_HOST=127.0.0.1 GLASS_PORT=$vnc GW_PORT=$gw \
  sbcl --core "$LOCAL_CORE" --dynamic-space-size "${KILN_HEAP:-4096}" \
       --load "$KILN_ROOT/webrtc-data/demo/glass-webrtc/gateway.lisp"
}

# ---- a folder you can move ---------------------------------------------------

cmd_bundle() {
  local zip="" out="$PWD/kiln-bundle" full=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --zip) zip=1 ;;
      --full) full=1 ;;
      --out) out=$2; shift ;;
      *) die "bundle: unknown option $1" ;;
    esac
    shift
  done
  [[ -d $KILN_ROOT/glass ]] || die "no checkouts at $KILN_ROOT to bundle"
  note "bundling from $KILN_ROOT -> $out"
  rm -rf "$out"; mkdir -p "$out/repos"

  # Excluded by default: version control, build artifacts, and the external
  # conformance corpora, which are most of the bytes and none of the desktop.
  # --full keeps everything.
  local ex=(--exclude ".git")
  [[ -z $full ]] && ex+=(--exclude "*.core"
                        --exclude "test262-full" --exclude "wpt"
                        --exclude "ansi-test" --exclude "modus-ref"
                        --exclude "inspect/vectors" --exclude "inspect/*.png")
  local n=0
  while read -r name branch commit; do
    case "$name" in \#*|"") continue ;; esac
    [[ -d $KILN_ROOT/$name ]] || { note "  skipping $name (not checked out)"; continue; }
    rsync -a "${ex[@]}" "$KILN_ROOT/$name/" "$out/repos/$name/" 2>/dev/null || \
      die "rsync failed for $name"
    n=$((n+1))
  done < "$ROOT/repos.lock"
  cp "$ROOT/repos.lock" "$out/repos.lock"
  mkdir -p "$out/boot"; cp "$ROOT/boot/build.lisp" "$out/boot/"

  cat > "$out/kiln-run" <<'LAUNCH'
#!/usr/bin/env bash
# kiln-run — start the desktop from this bundle, on this machine's SBCL.
#
# No container: this is your user and your ports.  The first run builds a core
# (McCLIM takes a few minutes); after that it starts in about a second.
set -euo pipefail
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$HERE/repos
CORE=$HERE/modus.core
DISPLAY_N=${GLASS_DISPLAY:-1}

command -v sbcl >/dev/null || { echo "kiln: no sbcl on PATH" >&2; exit 1; }
[ -f "$HOME/quicklisp/setup.lisp" ] || {
  echo "kiln: needs Quicklisp at ~/quicklisp (the desktop uses McCLIM)" >&2; exit 1; }

if [ ! -f "$CORE" ]; then
  echo "kiln: building the core, once — McCLIM takes a few minutes" >&2
  KILN_SOURCE_TREE="$ROOT" KILN_CORE="$CORE"     sbcl --dynamic-space-size 4096 --script "$HERE/boot/build.lisp"
fi

echo "kiln: desktop :$DISPLAY_N  ->  vnc://127.0.0.1:$((5900 + DISPLAY_N))" >&2
exec sbcl --core "$CORE" --control-stack-size 256 --dynamic-space-size "${KILN_HEAP:-4096}"      --load "$ROOT/glass/backend/inspect/serve-desktop.lisp"
LAUNCH
  chmod +x "$out/kiln-run"

  cat > "$out/README" <<'RM'
The modus-lisp desktop, as a folder.

    ./kiln-run                 vnc://127.0.0.1:5901
    GLASS_DISPLAY=3 ./kiln-run  ... on 5903 instead

Needs SBCL and a Quicklisp at ~/quicklisp (McCLIM comes from there).  The first
run compiles and dumps modus.core beside this file; later runs reuse it.

This is NOT the container.  It is your user, your files and your ports, and the
desktop's terminal is a shell as you.  What you get instead is that there is
nothing between you and the process: the sources are right here in repos/, and
editing one is live on the next start.

repos.lock records the commit every repo was taken from.
RM

  local size
  size=$(find "$out" -type f -print0 | xargs -0 stat -f%z 2>/dev/null | awk '{s+=$1} END {printf "%.0f", s/1048576}')
  note "$n repos, ${size} MB -> $out"
  if [[ -n $zip ]]; then
    note "zipping"
    (cd "$(dirname "$out")" && zip -qr "$(basename "$out").zip" "$(basename "$out")")
    note "$(dirname "$out")/$(basename "$out").zip"
  fi
}

# The box's identity and the keys allowed to configure it.  Generated on the
# HOST, with ssh-keygen, and mounted in — so the container never has to invent a
# credential, the host key is stable across rebuilds (known_hosts stays quiet),
# and you can read exactly what is trusted with cat.
# KILN_MOUNT_REPOS="conch glass" bind-mounts those local checkouts over the
# image's cloned copies, so uncommitted work can be tested without a push and a
# repin.  Development only — the image alone is no longer self-contained.
mount_repo_args() {
  local args=() repo
  for repo in $KILN_MOUNT_REPOS; do
    args+=(-v "$ROOT/../$repo:/opt/modus-lisp/$repo")
  done
  printf '%s\n' "${args[@]}"
}

ensure_etc() {
  mkdir -p "$KILN_ETC"
  chmod 700 "$KILN_ETC"
  if [[ ! -f $KILN_ETC/host_ed25519 ]]; then
    note "generating the box's SSH host key (once)"
    ssh-keygen -q -t ed25519 -N '' -C "kiln-box" -f "$KILN_ETC/host_ed25519"
  fi
  if [[ ! -s $KILN_ETC/authorized_keys ]]; then
    local pub=${KILN_AUTHORIZED_KEY:-}
    if [[ -z $pub ]]; then
      # conch verifies ssh-ed25519 only, so an RSA key here would be accepted by
      # the file and rejected at login — better to say so now.
      for cand in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do
        [[ -f $cand ]] && { pub=$(cat "$cand"); break; }
      done
    fi
    [[ -n $pub ]] || die "no ssh public key found.
  kiln authenticates its config TUI with YOUR key, and needs one to trust.
  Make one:            ssh-keygen -t ed25519
  or name one:         KILN_AUTHORIZED_KEY=\"\$(cat some_key.pub)\" kiln config"
    [[ $pub == ssh-ed25519* ]] || die "kiln needs an ssh-ed25519 key (conch verifies only that type).
  Found: ${pub%% *}.  Make one with:  ssh-keygen -t ed25519"
    printf '%s\n' "$pub" > "$KILN_ETC/authorized_keys"
    chmod 600 "$KILN_ETC/authorized_keys"
    note "trusting $(printf '%s' "$pub" | awk '{print $3}')"
  fi
}

# Configure the box the way you would configure a kernel: ssh in with the key you
# already have, and get a menuconfig.
cmd_config() {
  ensure_etc
  running || cmd_run
  # The control plane comes up beside the desktop; give it a moment on first boot.
  # Read the banner, do not merely connect: Apple's published-port proxy accepts
  # before anything inside is listening, so a bare `nc -z` says yes to a dead
  # port and ssh then dies with "Connection reset by peer".  SSH servers speak
  # first ("SSH-2.0-..."), which is a real liveness test.
  local up=""
  for _ in $(seq 1 90); do
    if [[ $(nc -w 2 127.0.0.1 "$SSH_PORT" 2>/dev/null | head -c 4) == SSH- ]]; then
      up=1; break
    fi
    sleep 1
  done
  [[ -n $up ]] || die "the SSH control plane never came up on $SSH_PORT (kiln logs)"
  note "connecting to the config TUI"
  # A pty is the point (it is a full-screen TUI), and the host key is kiln's own,
  # kept in $KILN_ETC — checked against a known_hosts file of its own so it never
  # argues with your real one.
  exec ssh -t -p "$SSH_PORT" \
       -i "${KILN_SSH_KEY:-$HOME/.ssh/id_ed25519}" \
       -o UserKnownHostsFile="$KILN_ETC/known_hosts" \
       -o StrictHostKeyChecking=accept-new \
       -o LogLevel=ERROR \
       kiln@127.0.0.1
}

cmd_web() {
  KILN_WEB=1 MODE=web
  export KILN_WEB
  running || cmd_run
  local url="http://localhost:$GW_PORT/"
  note "opening $url"
  [[ $(uname -s) == Darwin ]] && open "$url" || note "point a browser at $url"
}

# RFB is NOT published by default.  The desktop still listens on it inside the
# container — that is how the gateway reaches it — but nothing outside can. This
# turns it on, and it is a real widening: RFB's own auth is DES over a password
# truncated to eight characters, so the honest posture is off unless asked for.
cmd_vnc() {
  KILN_VNC=1; export KILN_VNC
  if running && ! nc -z -w2 127.0.0.1 "$VNC_PORT" 2>/dev/null; then
    note "restarting to publish $VNC_PORT"
    cmd_stop >/dev/null
  fi
  running || cmd_run
  local url="vnc://127.0.0.1:$VNC_PORT"
  if [[ $(uname -s) == Darwin ]]; then
    note "opening $url"; open "$url"
  else
    note "point a VNC client at $url"
  fi
}

cmd_stop() {
  ensure_engine_up
  running && { "$ENGINE" stop "$NAME" >/dev/null 2>&1 || true; note "stopped"; }
  exists  && { "$ENGINE" rm "$NAME"   >/dev/null 2>&1 || true; note "removed"; }
  true
}

# Apple's CLI spells this `image list`; docker and podman spell it `images`.
image_built() {
  local out
  if [[ $ENGINE == container ]]; then
    out=$(container image list 2>/dev/null)
  else
    out=$("$ENGINE" images 2>/dev/null)
  fi
  grep -q "${IMAGE%%:*}" <<<"$out"
}

cmd_status() {
  ensure_engine_up
  printf 'engine     %s\n' "$ENGINE"
  printf 'image      %s%s\n' "$IMAGE" \
    "$(image_built && echo '  (built)' || echo '  (not built — run: kiln build)')"
  printf 'container  %s  %s\n' "$NAME" "$(running && echo running || { exists && echo stopped || echo absent; })"
  printf 'display    :%s  vnc %s  audio %s  control %s\n' "$DISPLAY_N" "$VNC_PORT" "$AUDIO_PORT" "$CTRL_PORT"
}

cmd_logs()  { ensure_engine_up; "$ENGINE" logs "$@" "$NAME"; }
cmd_shell() { running || die "not running (kiln run)"; "$ENGINE" exec -ti "$NAME" /bin/bash; }
cmd_repl()  { running || die "not running (kiln run)"; "$ENGINE" exec -ti "$NAME" /kiln/boot/entrypoint.sh repl; }

# Evaluate in the LIVE desktop through its control socket — the running image,
# not a fresh one, so you can read perf and poke at a desktop mid-session.
#
# Runs INSIDE the container rather than over a published port, because glass
# binds the control socket to 127.0.0.1 (as it should — it is an unauthenticated
# eval socket).  Loopback inside a container is not loopback outside it, so
# publishing 4009 would expose nothing and forward nowhere.  bash's /dev/tcp
# does the talking, which saves installing a netcat just for this.
cmd_eval() {
  [[ $# -gt 0 ]] || die "eval needs a form, e.g. kiln eval '(glass:perf-report)'"
  running || die "not running (kiln run)"
  "$ENGINE" exec "$NAME" bash -c '
      exec 3<>/dev/tcp/127.0.0.1/'"$CTRL_PORT"' || exit 1
      printf "%s\n" "$1" >&3
      timeout 10 cat <&3' _ "$1"
}

cmd_test() { ensure_engine_up; set_dns_args; "$ENGINE" run --rm "${DNS_ARGS[@]}" "$IMAGE" test; }

cmd_lock() {
  ensure_engine_up
  note "reading the org's live refs with cairn"
  local tmp; tmp=$(mktemp)
  # The image is only the vehicle; the new lock lands on the host.
  set_dns_args
  "$ENGINE" run --rm "${DNS_ARGS[@]}" "$IMAGE" lock > "$tmp"
  if [[ -s $tmp ]]; then
    mv "$tmp" "$ROOT/repos.lock"
    note "repos.lock updated — rebuild to pick it up"
  else
    rm -f "$tmp"; die "lock produced no output; repos.lock left alone"
  fi
}

cmd_clean() {
  cmd_stop
  "$ENGINE" rmi "$IMAGE" >/dev/null 2>&1 || "$ENGINE" image rm "$IMAGE" >/dev/null 2>&1 || true
  note "image removed"
}

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//; $d'; }

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  run)   shift; cmd_run "$@" ;;
  vnc)   shift; cmd_vnc ;;
  web)   shift; cmd_web ;;
  config) shift; cmd_config ;;
  local)  shift; cmd_local "$@" ;;
  bundle) shift; cmd_bundle "$@" ;;
  stop)  shift; cmd_stop ;;
  status)shift; cmd_status ;;
  logs)  shift; cmd_logs "$@" ;;
  shell) shift; cmd_shell ;;
  repl)  shift; cmd_repl ;;
  eval)  shift; cmd_eval "$@" ;;
  test)  shift; cmd_test ;;
  lock)  shift; cmd_lock ;;
  clean) shift; cmd_clean ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
